C 0x7F8A los seis
C 0x7F8C C = indice

# ----------------------------------------------------------------------
# Segunda pasada: la ventana sobre la pista y las poses (0x655E-0x66A1)
# ----------------------------------------------------------------------
C 0x655E C = cuantas columnas
C 0x6562 fuera de la pista: nada
C 0x6566 columna nueva
C 0x6567 (0xECE5) al dia
