C 0x6357 sprite del balon
C 0x635B sombra del balon
C 0x635E cuarto sprite fijo
L 0x6365 sprite_red  Red en la posicion de pantalla (0xC5DB) mas su colocacion de 0xC5C0
L 0x637C sprite_balon  Balon en Y de pantalla mas altura de la mano, la Z y la colocacion; oculto si (0xECE7)
C 0x637C balon oculto
C 0x6382 Y 0xD1: fuera de la pantalla
C 0x6386 altura de la mano en vuelo
C 0x638B altura en la mano
C 0x638F Z del balon
L 0x63A3 sprite_sombra  Sombra del balon en el suelo; oculta si (0xECE7)
L 0x63BE sprite_fijo  Cuarto sprite del grupo con la colocacion fija de 0xC5CC
L 0x63CB guarda_atributos  Escribe Y, X, patron y color en la lista HL'
L 0x63DA x_pantalla  X de pantalla: (0xECE6) mas la X (+3) escalada por la curva 0xBCB4 segun la Y (+1); 0xE1 si se sale
C 0x63E4 escala segun la profundidad
C 0x63F5 X fina de la ventana
C 0x640A fuera: oculto
L 0x640F y_pantalla  Y de pantalla: curva 0xBC34 segun la Y (+1), mas 0x40; 0xE1 si pasa de 0xC0
L 0x6426 grupo_en_orden  HL = registro que va en el puesto A del orden de pintado (+0x0E), C su numero
C 0x6428 +0x0E del primer registro
L 0x6446 ordena_profundidad  Ordena los siete registros por la profundidad +1 (mayor primero) y guarda el puesto en +0x0E
C 0x6446 +1 de cada registro
C 0x6449 lista temporal en 0xEBD6
C 0x6461 ordenacion de burbuja
C 0x6471 puesto de cada registro
L 0x6493 intercambia  Cambia (DE) y (HL)
L 0x649A pon_puesto  Puesto C en +0x0E y marca usada
L 0x64A7 centra_ventana  Mueve la ventana una columna hacia la central (12)
C 0x64AF ya centrada
C 0x64B6 bit 4: hacia la derecha
C 0x64BD bit 3: hacia la izquierda
L 0x64CC desplaza_ventana  Si 0xC5DF pide desplazar, mueve la ventana una columna, ajusta la X fina y la canasta; si no, refresca el marcador
C 0x64D3 bit 4: desplaza a la derecha
C 0x64D7 X fina mas 8
C 0x64DC una columna menos
C 0x64DE canasta de la derecha
C 0x64EA bit 3: desplaza a la izquierda
C 0x64EF X fina menos 8
C 0x64F4 una columna mas
C 0x64F6 canasta de la izquierda
C 0x6501 copia la ventana
C 0x6505 recalcula la posicion de la red
C 0x650B tope: deja de desplazar
C 0x6511 deshace la X fina
C 0x6519 repinta FORMATION=
C 0x6521 marcador entero
L 0x6527 refresca_marcador  Sin desplazamiento: tiempo, faltas y rotulos pendientes
C 0x652B tiempo en el marcador
C 0x653E FORMATION= pendiente
L 0x6542 posicion_red  Posicion de pantalla de la red (0xC5DB) a partir de la canasta 0xC5D3
L 0x655E copia_ventana  Mueve la ventana A columnas (si cabe en 0-24) y copia sus 32 x 24 nombres de 0xCB3D a la VRAM; acarreo si no cabe
C 0x655F cabe la ventana?
C 0x6563 columna nueva
C 0x6570 primera columna en el mapa
C 0x6574 24 filas
C 0x657A 32 columnas por fila
C 0x6583 siguiente fila del mapa (56)
L 0x6593 limita_columna  A = columna de la ventana entre 0 y 0x19
L 0x65A2 cabe_columna  Acarreo si la columna mas C se sale de 0-24
L 0x65B1 extiende_a  DE = A con signo

B 0x502F ===== Faltas: rotulo, tiros libres y saques =====
L 0x502F pita_falta  Falta del jugador de 0xCB34: rotulo, silbato y, segun el tipo, tiros libres o saque
C 0x503C infractor
C 0x5045 posicion de la falta lejos del centro
C 0x5048 posicion de la falta
C 0x504C rotulo, silbato y ventana hacia la falta
C 0x504F al acabar, sin falta pendiente
C 0x5053 tipos 0-4 (pasos y cuentas): saque
C 0x5065 falta en ataque: saque
C 0x506A jugador que recibe la falta
C 0x5073 estaba en el aire (tirando)
C 0x5079 si: tiros libres
C 0x507C zona de la victima
C 0x5086 equipo con el balon
C 0x5089 faltas del equipo izquierdo
C 0x508F faltas del equipo derecho
C 0x5093 SUPOSICION: 7 o mas: tiros de bonus
L 0x509B sin_falta  Infractor, tipo y victima a 0xFF
L 0x50A7 pareja_infractor  A = defensor emparejado (+0x25) del infractor
L 0x50B3 bonus  SUPOSICION: tiros con el bit 7 (uno mas uno)
L 0x50B7 aparta_del_centro  SUPOSICION: si la X de la falta esta a menos de 8 del centro la lleva a +8 o -8 segun la ventana
L 0x50CD tiros_libres  Dos tiros libres para la victima: colocacion, bote, cinco segundos para tirar
C 0x50CD dos tiros
C 0x50D2 coloca a todos en la linea
C 0x50D5 balon al tirador
C 0x50DE movimiento y mandos bloqueados
C 0x50EC entradas a cero
C 0x50F2 hasta que lleguen todos
