# Segunda pasada: INIT y bucle principal (0x4010-0x412F)
# ----------------------------------------------------------------------
C 0x401C ranura primaria de la pagina 1 (bits 2-3 de RSLREG)
C 0x401F BC = ranura
C 0x4028 cuatro mas: SLTTBL
C 0x4040 la direccion del gancho: 0x687E
C 0x4043 interrupciones en marcha con el gancho puesto
C 0x404D pila otra vez al principio: aqui se vuelve del partido
C 0x406A el temporizador del titulo
C 0x406B a cero?
C 0x407C A = 0
C 0x4098 bit 1 de 0xED57 a cero: bit 0 de 0xEF98 a cero
C 0x40B1 hay falta?
C 0x40B8 hay pase?
C 0x40BF positivo: hay formacion que pintar
C 0x40CB cero: sigue el partido
C 0x40CC Z si el partido sigue
C 0x40D3 un jugador humano ha pedido cambio
C 0x40DB ninguno: nada
C 0x40E2 A = 3 o 4: que equipo
C 0x40E6 (0xCB35) = equipo del cambio
C 0x40EE interrupciones otra vez
C 0x40F5 un cuadro
C 0x40FE un cuadro
C 0x4107 un cuadro
C 0x410D un cuadro
C 0x4113 un cuadro
C 0x411E no esta activo: nada
C 0x4122 sin disparo: nada
C 0x4126 al titulo

