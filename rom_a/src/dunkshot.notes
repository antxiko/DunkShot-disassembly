C 0x6616 HL = los cuatro patrones
C 0x6619 guarda la cuenta
C 0x661A A = numero de patron
C 0x661B siguiente
C 0x661C guarda la pose
C 0x6668 y el hueco
C 0x6669 HL = patron
C 0x666C por 2
C 0x666D por 4
C 0x666E por 8
C 0x666F por 16
C 0x6670 por 32 bytes
C 0x6674 HL = el patron en RAM
C 0x6675 DE = el hueco
C 0x6620 32 bytes
C 0x6623 guarda el hueco
C 0x6624 el patron a la VRAM
C 0x6627 recupera el hueco
C 0x6628 32 mas
C 0x662B el hueco siguiente
C 0x662C DE = hueco
C 0x662D recupera la pose
C 0x662E y la cuenta
C 0x662F los cuatro patrones
C 0x6631 HL = pose
C 0x6632 L = pose
C 0x6677 sin los dos bits bajos: el grupo por cuatro
