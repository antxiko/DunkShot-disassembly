# ----------------------------------------------------------------------
# Segunda pasada sobre los mandos y la IA (0x956F-0x9BE2)
# ----------------------------------------------------------------------
C 0x956F guarda HL
C 0x9570 y el lado (A)
C 0x9574 C = modo
C 0x9576 A = modo * 3
C 0x9577 HL = desplazamiento en la tabla
C 0x957B que lado?
C 0x957C cero: la izquierda
C 0x9586 HL = direccion del jp de este lado y modo
C 0x958A vuelta en la pila
C 0x958C modo 0: la izquierda con el mando 2
C 0x958F modo 1: la izquierda con el mando 1
C 0x9592 modo 2: la izquierda la lleva la maquina
C 0x9595 modo 3: las dos la maquina
C 0x9598 modo 0: la derecha con el mando 1
C 0x959B modo 1: la derecha la lleva la maquina
C 0x959E modo 2: la derecha con el mando 1
C 0x95A1 modo 3: las dos la maquina
C 0x95A6 maquina: sin tabla de direcciones
C 0x95A9 HL = direccion * 2
C 0x95AF HL = su par (dx, dy)
C 0x95B0 D = dx
C 0x95B2 E = dy
C 0x95B4 guarda los botones
C 0x95B8 0xFF: ningun jugador bloqueado
C 0x95BF es este el bloqueado?
C 0x95C4 DE = 0: no se mueve
C 0x95C7 recupera los botones
C 0x95C8 y HL
C 0x95CA primero el joystick 1
C 0x95CD B = botones
C 0x95D0 botones o direccion: hay entrada
C 0x95D1 A = botones
C 0x95D2 con entrada del joystick, listo
C 0x95D8 C = direccion de los cursores
C 0x95DB SNSMAT no respeta BC
C 0x95E0 B = botones, de momento ninguno
C 0x95E6 '[' no pulsada
C 0x95E8 bit 7: disparo
C 0x95EC SNSMAT no respeta BC
C 0x95F5 RETURN no pulsada
C 0x95F7 bit 6: pase
C 0x95F9 A = botones
C 0x95FB GTSTCK 1: el joystick del puerto 1
C 0x9600 C = direccion 0-8
C 0x9601 B = botones
C 0x9603 GTTRIG 1: boton A del puerto 1
C 0x9605 GTTRIG no respeta BC
C 0x960A pulsado?
C 0x960D bit 7: disparo
C 0x960F GTTRIG 3: boton B del puerto 1
C 0x9616 pulsado?
C 0x9619 bit 6: pase
C 0x961B A = botones
C 0x961D primero el joystick 2
C 0x9620 B = botones
C 0x9621 solo los bits de boton
C 0x9623 botones o direccion: hay entrada
C 0x9624 A = botones
C 0x9625 con entrada del joystick, listo
C 0x962D C = C, D, E en los bits 1-3
C 0x9630 SNSMAT no respeta BC
C 0x9637 mas R en el bit 0
C 0x963A DE = indice en la tabla
C 0x9641 C = direccion 0-8
C 0x9642 B = botones, de momento ninguno
C 0x9646 SNSMAT no respeta BC
C 0x964D TAB no pulsada
C 0x964F bit 7: disparo
C 0x9653 SNSMAT no respeta BC
