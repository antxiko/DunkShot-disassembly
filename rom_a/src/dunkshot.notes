C 0x6D61 fila 0, columna 6
C 0x6D64 cuatro filas de 21
C 0x6D67 el cuadro
C 0x6D79 el nombre del equipo de la izquierda (0xC617)
C 0x6D7C tres letras en la VRAM DE
C 0x6D82 el de la derecha (0xC703)
C 0x6D85 tres letras
C 0x6D88 (0xED66): mitad en curso, 0 o 1
C 0x6D8B patron 0x2E o 0x2F: el 1 o el 2 del "HALF"
C 0x6D8D fila 1, columna 14
C 0x6D90 a la VRAM
C 0x6D93 (0xED5C) a cero
C 0x6D97 HL = segundos que quedan
