C 0x656D DE = la columna, con signo
C 0x6573 HL = la columna en la fila 0 del mapa
C 0x6576 fila 0 de la tabla de nombres
C 0x6579 guarda la cuenta de filas
C 0x657D guarda el destino
C 0x657E y el origen
