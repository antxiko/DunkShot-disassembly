C 0x6071 2 o mas: A + 1 repeticiones
C 0x6073 el byte a repetir
C 0x6074 al destino
C 0x6075 siguiente
C 0x6076 B veces
C 0x6078 ficha siguiente
C 0x6079 recupera mascara y valor
C 0x607A otra ficha
C 0x607E un literal: B = 1 y a copiarlo
C 0x6080 0 o 1?
C 0x6081 1: con los bits al reves (0x6089 con B = 1)
C 0x6084 indice 0xFF: fin
C 0x6085 otro indice: diccionario
C 0x6087 recupera mascara y valor
C 0x6088 HL = primera direccion despues del bloque
C 0x6089 guarda la ficha
C 0x608A B = 0 (copia) o 1 (bits al reves)
C 0x608B A = indice del diccionario
C 0x608C registros alternativos
C 0x608E HL' = indice
C 0x6090 por dos
C 0x6091 por cuatro
C 0x6092 por ocho
C 0x6093 mas la base: la entrada de ocho bytes ya escrita
C 0x6094 guardada
C 0x6095 registros normales
C 0x6096 HL = la entrada
C 0x6097 copia o al reves?
C 0x6098 cero: copia
C 0x6099 uno: al reves
C 0x609E ocho bytes tal cual
C 0x60A0 recupera el puntero de fichas
C 0x60A1 ficha siguiente
C 0x60A5 guarda el destino
C 0x60A6 un byte de la entrada
C 0x60A9 un bit por la derecha
C 0x60AA entra por la izquierda de D
C 0x60AC los ocho bits
C 0x60AE A = el byte dado la vuelta
C 0x60AF recupera el destino
C 0x60B0 al destino
C 0x60B1 siguiente
C 0x60B2 siguiente byte de la entrada
C 0x60B3 los ocho
C 0x60B4 otro byte
C 0x60B6 ficha siguiente
C 0x60B8 C = mascara
C 0x60B9 siguiente
C 0x60BA B = valor de control
C 0x60BB HL = primera ficha
C 0x60BC guarda mascara y valor
C 0x60BD la ficha
C 0x60BE solo los bits de la mascara
C 0x60BF es de control?
C 0x60C0 no: literal
C 0x60C2 el byte siguiente
C 0x60C4 distinto de la ficha: repeticion
C 0x60C6 igual: recupera y acaba
C 0x60C7 HL = primera direccion despues del bloque
C 0x60C8 A = ~mascara
C 0x60C9 complemento
C 0x60CA de vuelta a la ficha
C 0x60CB la ficha sin los bits de control
C 0x60CC al byte siguiente
C 0x60CD mascara impar?
C 0x60CF par: tal cual
C 0x60D1 impar: el bit 0 fuera
C 0x60D4 B = A + 3 repeticiones
C 0x60D5 el byte a repetir
C 0x60D6 al destino
C 0x60D7 siguiente
C 0x60D8 B veces
C 0x60DA ficha siguiente
C 0x60DB recupera mascara y valor
C 0x60DC otra ficha
C 0x60DE un literal
C 0x60E0 a copiarlo
C 0x60E2 se salta el primer byte
C 0x60E3 C = la marca
C 0x60E4 primera ficha
C 0x60E5 la ficha
C 0x60E6 es la marca?
C 0x60E7 no: literal
C 0x60E9 el byte siguiente
C 0x60EA la marca otra vez: fin
C 0x60EB HL = la segunda marca
C 0x60EC A = el byte a repetir
C 0x60ED siguiente
C 0x60EE B = cuantas veces (0 = 256)
C 0x60EF al destino
C 0x60F0 siguiente
C 0x60F1 B veces
C 0x60F3 ficha siguiente
C 0x60F4 otra ficha
C 0x60F6 un literal
C 0x60F8 a copiarlo
C 0x60FA el primer byte de la ficha
C 0x60FB 0x10 o mas: una sola pareja
C 0x60FD a copiarla
C 0x6100 B = alto de la cuenta
C 0x6101 C = bajo
C 0x6102 HL = la pareja
C 0x6103 alto a cero?
C 0x6104 no: cuenta de verdad
C 0x6107 cuenta cero: fin
C 0x6108 cuenta + 1
C 0x6109 A = primer byte de la pareja
C 0x610A siguiente
C 0x610B guarda el puntero
C 0x610C L = segundo byte
C 0x610D H = primero
C 0x610E el primero
C 0x610F al destino
C 0x6110 siguiente
C 0x6111 el segundo
C 0x6112 al destino
C 0x6113 siguiente
C 0x6114 una pareja menos
C 0x6115 quedan?
C 0x6117 otra
C 0x6119 recupera el puntero
C 0x611A ficha siguiente
C 0x611B otra ficha
C 0x6120 una pareja: a copiarla
