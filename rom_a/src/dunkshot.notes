C 0x6DC5 fila 2, columna 10: puntos de la izquierda
C 0x6DCB tres cifras
C 0x6DCE fila 2, columna 20: puntos de la derecha
C 0x6DD4 HL = los puntos, un byte
C 0x6DD6 guarda la posicion
C 0x6DD7 C = 0: ningun digito escrito
C 0x6DDC A = centenas
C 0x6DDF recupera la posicion
C 0x6DE0 digito o blanco
C 0x6DE3 a la VRAM
C 0x6DE6 guarda la posicion
C 0x6DEA A = decenas
C 0x6DED recupera la posicion
C 0x6DEE digito o blanco
C 0x6DF1 a la VRAM
C 0x6DF5 las unidades, siempre
C 0x6DF7 HL = posicion
C 0x6DF8 el digito
C 0x6DFB posicion siguiente
C 0x6DFC DE = posicion
C 0x6DFE guarda la posicion
C 0x6DFF C = 0: ningun digito escrito
C 0x6E01 10000
C 0x6E04 A = decenas de millar
C 0x6E07 recupera la posicion
C 0x6E08 digito o blanco
C 0x6E0B a la VRAM
C 0x6E0E guarda la posicion
C 0x6E0F 1000
C 0x6E12 A = millares
C 0x6E15 recupera la posicion
C 0x6E16 digito o blanco
C 0x6E19 a la VRAM
C 0x6E1C guarda la posicion
C 0x6E1D y sigue con las tres cifras de abajo
C 0x6E1F A = 0: la cuenta
C 0x6E20 HL -= DE
C 0x6E22 ya no cabe
C 0x6E24 una mas
C 0x6E25 C tambien
C 0x6E26 otra vez
C 0x6E28 deshace la ultima resta
C 0x6E2A el digito
C 0x6E2C C sin cambiar
C 0x6E2E C no era cero: el digito
C 0x6E2F C era cero: blanco
C 0x6E32 quita la marca de repintar
C 0x6E34 C = formacion
C 0x6E38 "FORMATION="
C 0x6E3B al rotulo
C 0x6E3E A = formacion
C 0x6E3F cero?
C 0x6E40 cero: la letra de ninguna
C 0x6E44 a escribirla
C 0x6E48 la letra a la VRAM
C 0x6E50 quita la marca de repintar
C 0x6E52 C = zona
C 0x6E56 "AREA="
C 0x6E59 al rotulo
C 0x6E5C A = zona
C 0x6E5D cero?
C 0x6E5E cero: la F
C 0x6E60 '1' + zona - 1: 1, 2 o 3
C 0x6E62 a escribirla
C 0x6E64 la F
C 0x6E66 a la VRAM
C 0x6E69 hay disparo o espacio?
C 0x6E6C si: a cambiar
C 0x6E71 el temporizador a cero?
C 0x6E72 sigue esperando
C 0x6E78 cero: nada que cambiar
C 0x6E79 hay cambios
C 0x6E7B solo rehacer la pista
C 0x6E80 ya estaba el mensaje?
C 0x6E81 si: espera
C 0x6E84 marca que esta
C 0x6E88 una fila
C 0x6E8B patron 0x84
C 0x6E8D la fila entera
C 0x6E90 sprites quietos
C 0x6E96 "MEMBER CHANGE."
C 0x6E99 al rotulo
C 0x6E9C sprites otra vez
C 0x6E9F y a esperar
C 0x6EA1 (0xED56): modo del equipo de la izquierda
C 0x6EA4 humano?
C 0x6EA5 si: rehacer
C 0x6EAA (0xED57) humano?
C 0x6EAB los dos de la maquina: nada
C 0x6EAC sprites quietos mientras se repinta
C 0x6EB8 las posiciones de los dos equipos
C 0x6EBB nombres en blanco
C 0x6EBE patrones y colores de la pista
C 0x6EC1 el mapa de 56 columnas a 0xCB3D
C 0x6EC4 la ventana
C 0x6EC7 sprites otra vez
