C 0x658C la fila siguiente de la tabla de nombres
C 0x658D DE = destino
C 0x658E HL = origen
C 0x658F recupera la cuenta
C 0x6590 las 24 filas
C 0x6593 la columna
C 0x6596 negativa?
C 0x6597 no: mira el tope
C 0x659A si: cero
C 0x659C 25 o mas?
C 0x659E no: vale
C 0x659F si: 25
C 0x65A2 la columna
