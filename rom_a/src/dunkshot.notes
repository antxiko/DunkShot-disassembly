C 0x965C bit 6: pase
C 0x965E A = botones
C 0x9660 GTSTCK 2: el joystick del puerto 2
C 0x9665 C = direccion 0-8
C 0x9666 B = botones
C 0x9668 GTTRIG 2: boton A del puerto 2
C 0x966A GTTRIG no respeta BC
C 0x966F pulsado?
C 0x9672 bit 7: disparo
C 0x9674 GTTRIG 4: boton B del puerto 2
C 0x967B pulsado?
C 0x967E bit 6: pase
C 0x9680 A = botones
C 0x96A7 A = 0x81 si hay orden pendiente, 0x01 si no
C 0x96AA guarda el codigo
C 0x96AE bit 0: lados cambiados
C 0x96B0 cambiados: decide como el otro lado
C 0x96BF A = 0x81 si hay orden pendiente, 0x01 si no
C 0x96C2 guarda el codigo
C 0x96C6 bit 0: lados cambiados
C 0x96C8 cambiados: decide como el otro lado
C 0x96CA la derecha ataca: decide_atacante
C 0x96D8 recupera el codigo
C 0x96D9 con orden pendiente (0x81): devuelve el codigo tal cual
C 0x96DD lleva el balon?
C 0x96DE si: mira si tira
C 0x96E0 no: sin boton
C 0x96E3 la orden pendiente del lado
C 0x96E5 0x81: maquina con orden
C 0x96E8 0x01: maquina sin orden
