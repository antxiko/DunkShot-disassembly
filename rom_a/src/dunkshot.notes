C 0x6147 los B bytes
C 0x614D interrupciones otra vez
C 0x614E recupera la cuenta
C 0x614F 256 mas
C 0x6151 un bloque de 256 menos
C 0x6152 los que queden
C 0x6157 (0xEBCD): el origen
C 0x615A direccion de lectura
C 0x615F HL = destino en RAM
C 0x6160 A = bajo de la cuenta
C 0x6161 B = bajo
C 0x6162 C = alto
C 0x6163 mas uno
C 0x6164 guarda la cuenta
C 0x6168 C = puerto de datos
C 0x6169 sin interrupciones
C 0x616A un byte de la VRAM a (HL), HL++, B--
C 0x616C DE lleva la cuenta
C 0x616D los B bytes
C 0x616F (0xEBCD) = siguiente direccion
C 0x6173 interrupciones otra vez
C 0x6174 recupera la cuenta
C 0x6175 256 mas
C 0x6177 un bloque menos
C 0x6178 los que queden
C 0x617B guarda HL
C 0x617C DE
C 0x617D y el valor
C 0x617E (0xEBCD): destino
C 0x6181 DE = cuenta
C 0x6186 puerto de datos del VDP
C 0x6189 en C
C 0x618A el valor
C 0x618B sin interrupciones mientras se escribe
C 0x618C a la VRAM
C 0x618E siguiente
C 0x618F (0xEBCD) al dia
C 0x6192 interrupciones
C 0x6193 guarda el valor
C 0x6194 uno menos
C 0x6196 quedan?
C 0x6197 otro
C 0x6199 recupera el valor
C 0x619A DE
C 0x619B y HL
C 0x61A0 pantalla apagada?
C 0x61A1 si: nada
C 0x61A5 A = registro 5 guardado (RG5SAV)
C 0x61A6 cambia el bit 2: 0x1B00 <-> 0x1F00
C 0x61A8 guardado
C 0x61AA B = valor
C 0x61AB registro 5
C 0x61B6 A = alto del puntero
C 0x61B7 sin el bit de escritura
C 0x61B9 era de lectura?
C 0x61BE (0xECE8) = 0xFF: pantalla parada
C 0x61C3 registro 5 guardado
C 0x61C8 0x1B: la de la BIOS, sin alternar
C 0x61C9 guarda BC
C 0x61CA y HL
C 0x61CB alterna la tabla de atributos
C 0x61CE recupera HL
C 0x61CF y BC
C 0x61D1 (0xECE8) = 0: pantalla en marcha
C 0x61D6 monta en 0xEC65 los siete grupos de atributos en el orden de este cuadro (grupo_en_orden) y deja en HL el final
C 0x61DB DE = ultimo tamano de la lista de grupos (0xEBDE-0xEBE4)
C 0x61DE DE' = destino en 0xEBE5
C 0x61E3 A = tamano del grupo
C 0x61E4 tamano anterior
C 0x61E5 guarda la lista
C 0x61E6 DE = tamano
C 0x61E9 HL -= tamano: principio del grupo
C 0x61EC recupera la lista
C 0x61ED guarda el tamano
C 0x61EE y el origen
C 0x61F0 BC' = tamano
C 0x61F3 HL' = origen
C 0x61F4 guarda el tamano
C 0x61F5 y el destino
C 0x61F6 copia el grupo
C 0x61F8 recupera el destino
C 0x61F9 y el tamano
C 0x61FA HL' = destino
C 0x61FB mas el tamano
C 0x61FC DE' = destino siguiente
C 0x61FE recupera el tamano
C 0x61FF guarda la lista
C 0x6200 DE = tamano
C 0x6204 HL -= tamano: el principio del grupo anterior (0xEC65 se recorre de atras adelante: 0xEBE5 queda con los grupos al reves)
C 0x6206 recupera la lista
C 0x6207 A = tamano del grupo anterior
C 0x6208 lista hacia atras
C 0x6209 los siete grupos
C 0x6211 la tabla de atributos de 0x1B00: los grupos en el orden del cuadro
C 0x6214 desde 0xEC65
C 0x6217 0x80 bytes: los 32 sprites
C 0x621D la de 0x1F00: los mismos al reves; el registro 5 (0x61A2) dice cual se ve
C 0x6220 desde 0xEBE5
C 0x6223 0x80 bytes, y vuelve


# ----------------------------------------------------------------------
# Segunda pasada: los cuatro descompresores (0x6056-0x7F8F)
