# ----------------------------------------------------------------------
# Segunda pasada: rotulos de falta, marcador e impresores (0x6CA6-0x6FA9)
# ----------------------------------------------------------------------
C 0x6CA6 L = indice del rotulo
C 0x6CA7 HL = indice
C 0x6CA9 BC = indice
C 0x6CAB por dos
C 0x6CAC por cuatro
C 0x6CAD DE = indice * 4
C 0x6CAE guardado
