C 0x680F hacia abajo desde 0xC23F
C 0x6810 byte anterior
C 0x6811 posicion de arriba
C 0x6812 L llego a cero: ya esta
C 0x6814 posicion de abajo
C 0x6815 siguiente
C 0x681A copia el ultimo tramo
C 0x612A (0xEBCD): puntero de VRAM en curso
C 0x612D direccion de lectura
C 0x6132 HL = destino, DE = origen
C 0x6133 (0xEBCD): destino en curso
C 0x6139 HL = origen
C 0x613B B = bajo de la cuenta
C 0x613C C = alto
C 0x613D mas uno para el djnz implicito
C 0x613E guarda la cuenta
C 0x6142 C = puerto de datos del VDP (0x0007 de la BIOS)
