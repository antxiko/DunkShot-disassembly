L 0x8365 bit_de  A = 1 desplazado B veces
L 0x836F fondo_titulo  Fondo del titulo (0xB0FE) y nombres de los dos equipos
C 0x8372 fondo comprimido
C 0x8381 17 filas
C 0x8387 nombre del equipo izquierdo
C 0x8390 nombre del equipo derecho
L 0x8396 copia_tres  Copia los tres caracteres de HL a la VRAM DE (nombre de equipo)
L 0x839C pantalla_titulo  Titulo: fondo, copyright de HAL y los dos creditos
C 0x839F @1986 HAL LABORATORY
C 0x83A8 F;NAKAMURA
C 0x83B1 S;MIRROR
L 0x83BA menu_titulo  Menu del titulo: SET-UP, LEFT TEAM, RIGHT TEAM y TRADE
C 0x83BB cuentas del equipo izquierdo a cero
C 0x83C4 cuentas del equipo derecho a cero
C 0x83D3 cuadro del menu
C 0x83DC SET-UP, LEFT TEAM, RIGHT TEAM, TRADE
L 0x83EB suelta_espacio  Espera a soltar el espacio
L 0x83F4 menu_titulo_elige  Selector de cuatro opciones; solo vale el espacio
C 0x83F7 cuatro opciones, cursor 0x6F
C 0x8404 SET-UP
C 0x8406 LEFT TEAM
C 0x840E menu del equipo
C 0x8413 RIGHT TEAM
