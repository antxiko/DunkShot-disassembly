C 0x8EB4 el alto
C 0x8EB8 D = periodo alto
C 0x8EB9 el byte del desplazamiento
C 0x8EBA guarda el puntero
C 0x8EBC H = 0
C 0x8EBE signo del desplazamiento
C 0x8EBF positivo
C 0x8EC2 negativo: H = 0xFF
C 0x8EC3 HL = desplazamiento con signo
C 0x8EC5 DE = periodo nuevo
C 0x8EC6 recupera el puntero
C 0x8EC7 A = registro bajo
C 0x8ECB A = registro bajo
C 0x8ECC el alto
C 0x8ECD E = periodo alto
C 0x8ED1 ficha siguiente
C 0x8ED2 y otra ficha


# ----------------------------------------------------------------------
# Segunda pasada: rotulos de falta, marcador e impresores (0x7956-0x7C54)
# ----------------------------------------------------------------------
C 0x7956 L = indice del rotulo
C 0x7957 HL = indice
C 0x7959 BC = indice
C 0x795B por dos
C 0x795C por cuatro
C 0x795D DE = indice * 4
C 0x795E guardado
C 0x795F por ocho
C 0x7960 mas cuatro: por doce
C 0x7961 mas uno: por trece, lo que mide cada rotulo
C 0x7962 la tabla de los doce rotulos
C 0x7965 HL = el rotulo
C 0x7966 fila 2, columna 10 de la pantalla
C 0x7969 trece caracteres
C 0x796C a la VRAM
C 0x7A0E el marcador descomprimido (0x77A2)
C 0x7A11 fila 0, columna 6
C 0x7A14 cuatro filas de 21
C 0x7A17 el cuadro
C 0x7A29 el nombre del equipo de la izquierda (0xE851)
C 0x7A2C tres letras en la VRAM DE
C 0x7A32 el de la derecha (0xE93D)
C 0x7A35 tres letras
C 0x7A38 (0xED78): mitad en curso, 0 o 1
C 0x7A3B patron 0x2E o 0x2F: el 1 o el 2 del "HALF"
C 0x7A3D fila 1, columna 14
C 0x7A40 a la VRAM
C 0x7A43 (0xEFDC) a cero
C 0x7A47 HL = segundos que quedan
C 0x7A4A fila 2, columna 14: los minutos
C 0x7A4F guarda la posicion
C 0x7A53 A = decenas de minuto (600 s), C acumula
C 0x7A56 recupera la posicion
C 0x7A57 A = digito o blanco
C 0x7A5A a la VRAM, DE++
C 0x7A5E guarda la posicion
C 0x7A62 A = minutos sueltos (60 s)
C 0x7A65 recupera la posicion
C 0x7A66 digito (C ya no es cero)
C 0x7A69 a la VRAM
C 0x7A6E los segundos, en dos cifras, detras del ':'
C 0x7A71 (0xEFDE) a cero
C 0x7A75 fila 2, columna 10: puntos de la izquierda
C 0x7A7B tres cifras
C 0x7A7E fila 2, columna 20: puntos de la derecha
C 0x7A84 HL = los puntos, un byte
C 0x7A86 guarda la posicion
C 0x7A87 C = 0: ningun digito escrito
C 0x7A8C A = centenas
C 0x7A8F recupera la posicion
C 0x7A90 digito o blanco
C 0x7A93 a la VRAM
C 0x7A96 guarda la posicion
C 0x7A9A A = decenas
C 0x7A9D recupera la posicion
C 0x7A9E digito o blanco
C 0x7AA1 a la VRAM
C 0x7AA5 las unidades, siempre
C 0x7AA7 HL = posicion
C 0x7AA8 el digito
C 0x7AAB posicion siguiente
C 0x7AAC DE = posicion
C 0x7AAE guarda la posicion
C 0x7AAF C = 0: ningun digito escrito
C 0x7AB1 10000
C 0x7AB4 A = decenas de millar
C 0x7AB7 recupera la posicion
C 0x7AB8 digito o blanco
C 0x7ABB a la VRAM
C 0x7ABE guarda la posicion
C 0x7ABF 1000
C 0x7AC2 A = millares
C 0x7AC5 recupera la posicion
C 0x7AC6 digito o blanco
C 0x7AC9 a la VRAM
C 0x7ACC guarda la posicion
C 0x7ACD y sigue con las tres cifras de abajo
C 0x7ACF A = 0: la cuenta
C 0x7AD0 HL -= DE
C 0x7AD2 ya no cabe
C 0x7AD4 una mas
C 0x7AD5 C tambien
C 0x7AD6 otra vez
C 0x7AD8 deshace la ultima resta
C 0x7ADA el digito
C 0x7ADC C sin cambiar
C 0x7ADE C no era cero: el digito
C 0x7ADF C era cero: blanco
C 0x7AE2 quita la marca de repintar
C 0x7AE4 C = formacion
C 0x7AE8 "FORMATION="
C 0x7AEB al rotulo
C 0x7AEE A = formacion
C 0x7AEF cero?
C 0x7AF0 cero: la letra de ninguna
C 0x7AF4 a escribirla
C 0x7AF8 la letra a la VRAM
C 0x7AFB quita la marca de repintar
C 0x7AFD C = zona
C 0x7B01 "AREA="
C 0x7B04 al rotulo
C 0x7B07 A = zona
C 0x7B08 cero?
C 0x7B09 cero: la F
C 0x7B0B '1' + zona - 1: 1, 2 o 3
C 0x7B0D a escribirla
C 0x7B0F la F
C 0x7B11 a la VRAM
C 0x7B14 hay disparo o espacio?
C 0x7B17 si: a cambiar
C 0x7B1C el temporizador a cero?
C 0x7B1D sigue esperando
C 0x7B23 cero: nada que cambiar
C 0x7B24 hay cambios
C 0x7B26 solo rehacer la pista
C 0x7B2B ya estaba el mensaje?
C 0x7B2C si: espera
C 0x7B2F marca que esta
C 0x7B33 una fila
C 0x7B36 patron 0x84
C 0x7B38 la fila entera
C 0x7B3B sprites quietos
C 0x7B41 "MEMBER CHANGE."
C 0x7B44 al rotulo
C 0x7B47 sprites otra vez
C 0x7B4A y a esperar
C 0x7B4C (0xEFD6): modo del equipo de la izquierda
C 0x7B4F humano?
C 0x7B50 si: rehacer
C 0x7B55 (0xEFD7) humano?
C 0x7B56 los dos de la maquina: nada
C 0x7B57 sprites quietos mientras se repinta
C 0x7B63 las posiciones de los dos equipos
C 0x7B66 nombres en blanco
C 0x7B69 patrones y colores de la pista
C 0x7B6C el mapa de 56 columnas a 0xC400
C 0x7B6F la ventana
C 0x7B72 sprites otra vez
C 0x7B75 opcion a cero
C 0x7B7B 0x260 bytes: 19 filas
C 0x7B7E blanco
C 0x7B80 filas 5 a 23 borradas
C 0x7B86 18 filas de alto, 30 de ancho
C 0x7B89 el cuadro de la ficha
C 0x7B8C fila 6, columna 2
C 0x7B8F 28 de barra, el nombre a 12
C 0x7B92 la barra de color con el nombre
C 0x7B97 fila 7, columna 2
C 0x7B9A 28 patrones
C 0x7B9D la linea
C 0x7BA3 fila 19, columna 15
C 0x7BA6 4 filas de 3
C 0x7BA9 patron 0x8F
C 0x7BAB el hueco de las habilidades del equipo
C 0x7BAE la cabecera de la plantilla (NO PLAYER FOULS FATIGUE y 1-8)
C 0x7BB1 los ocho nombres
C 0x7BB4 quien esta en pista
C 0x7BB7 las faltas
C 0x7BBA la fatiga, y vuelve
C 0x7BBD patron 0xFA: linea
C 0x7BBF fila 18, columna 2
C 0x7BC2 28 de ancho
C 0x7BC5 la linea de abajo
C 0x7BC8 patron 0xF4: linea fina
C 0x7BCA fila 9, columna 2
C 0x7BCD la linea bajo la cabecera
C 0x7BD3 fila 8, columna 3
C 0x7BD6 NO PLAYER FOULS FATIGUE
C 0x7BDC "12345678"
C 0x7BDF ocho filas de un caracter
C 0x7BE2 la columna de numeros, y vuelve
C 0x7BE5 "SKILL"
C 0x7BE8 fila 19, columna 22
C 0x7BEB a la VRAM
C 0x7BEE "STATISTICS"
C 0x7BF1 fila 19, columna 3
C 0x7BF4 a la VRAM
C 0x7BF7 fila 20, columna 19
C 0x7BFA "S." "J." "R."
C 0x7BFD tres filas de dos
C 0x7C00 la columna de las habilidades
C 0x7C03 fila 20, columna 3
C 0x7C06 "SCORE:" "FOULS:" "GAMES:"
C 0x7C09 tres filas de seis
C 0x7C0C la columna de las estadisticas
C 0x7C0F fila 20, columna 21
C 0x7C12 las barras de habilidad del equipo
C 0x7C15 fila 20, columna 9
C 0x7C18 los tres numeros, y vuelve
C 0x7C1B guarda el principio de la cadena
C 0x7C1C un caracter
C 0x7C1D cero: fin
C 0x7C1E sigue

# ----------------------------------------------------------------------
# Segunda pasada: tablas de perspectiva, VRAM y atributos (0x5A58-0x5BFA)
# ----------------------------------------------------------------------
C 0x5A58 0xC000: la tabla de 256 palabras (bajo en 0xC0xx, alto en 0xC1xx)
C 0x5A5B guarda la posicion
C 0x5A5C A = indice 0-255
C 0x5A5D E = indice
C 0x5A61 DE = el valor
C 0x5A62 recupera la posicion
C 0x5A64 0xC1xx
C 0x5A66 0xC0xx
C 0x5A67 siguiente indice
C 0x5A68 los 256
C 0x5A6A A = 0: el primer valor
C 0x5A71 B = longitud del tramo
C 0x5A72 el valor, B veces
C 0x5A73 siguiente posicion
C 0x5A74 el tramo
C 0x5A76 siguiente longitud
C 0x5A77 valor siguiente
C 0x5A7A hasta 0x21: 33 tramos
C 0x5A7C sin acarreo para el ultimo byte
C 0x5A86 un byte de la tabla, de atras adelante
C 0x5A87 hacia arriba desde 0xC240
C 0x5A88 hacia abajo desde 0xC23F
C 0x5A89 byte anterior
C 0x5A8A posicion de arriba
C 0x5A8B L llego a cero: ya esta
C 0x5A8D posicion de abajo
C 0x5A8E siguiente
C 0x5A93 copia el ultimo tramo
C 0x5AFF (0xE718): puntero de VRAM en curso
C 0x5B02 direccion de lectura
C 0x5B07 HL = destino, DE = origen
C 0x5B08 (0xE718): destino en curso
C 0x5B0E HL = origen
C 0x5B10 B = bajo de la cuenta
C 0x5B11 C = alto
C 0x5B12 mas uno para el djnz implicito
C 0x5B13 guarda la cuenta
C 0x5B17 C = puerto de datos del VDP (0x0007 de la BIOS)
C 0x5B19 un byte a la VRAM, HL++, B--
C 0x5B1B DE lleva la cuenta del destino
C 0x5B1C los B bytes
C 0x5B22 interrupciones otra vez
C 0x5B23 recupera la cuenta
C 0x5B24 256 mas
C 0x5B26 un bloque de 256 menos
C 0x5B27 los que queden
C 0x5B2C (0xE718): el origen
C 0x5B2F direccion de lectura
C 0x5B34 HL = destino en RAM
C 0x5B35 A = bajo de la cuenta
C 0x5B36 B = bajo
C 0x5B37 C = alto
C 0x5B38 mas uno
C 0x5B39 guarda la cuenta
C 0x5B3D C = puerto de datos
C 0x5B3E sin interrupciones
C 0x5B3F un byte de la VRAM a (HL), HL++, B--
C 0x5B41 DE lleva la cuenta
C 0x5B42 los B bytes
C 0x5B44 (0xE718) = siguiente direccion
C 0x5B48 interrupciones otra vez
C 0x5B49 recupera la cuenta
C 0x5B4A 256 mas
C 0x5B4C un bloque menos
C 0x5B4D los que queden
C 0x5B50 guarda HL
C 0x5B51 DE
C 0x5B52 y el valor
C 0x5B53 (0xE718): destino
C 0x5B56 DE = cuenta
C 0x5B5B puerto de datos del VDP
C 0x5B5E en C
C 0x5B5F el valor
C 0x5B60 sin interrupciones mientras se escribe
C 0x5B61 a la VRAM
C 0x5B63 siguiente
C 0x5B64 (0xE718) al dia
C 0x5B67 interrupciones
C 0x5B68 guarda el valor
C 0x5B69 uno menos
C 0x5B6B quedan?
C 0x5B6C otro
C 0x5B6E recupera el valor
C 0x5B6F DE
C 0x5B70 y HL
C 0x5B75 pantalla apagada?
C 0x5B76 si: nada
C 0x5B7A A = registro 5 guardado (RG5SAV)
C 0x5B7B cambia el bit 2: 0x1B00 <-> 0x1F00
C 0x5B7D guardado
C 0x5B7F B = valor
C 0x5B80 registro 5
C 0x5B8B A = alto del puntero
C 0x5B8C sin el bit de escritura
C 0x5B8E era de lectura?
C 0x5B93 (0xE833) = 0xFF: pantalla parada
C 0x5B98 registro 5 guardado
C 0x5B9D 0x1B: la de la BIOS, sin alternar
C 0x5B9E guarda BC
C 0x5B9F y HL
C 0x5BA0 alterna la tabla de atributos
C 0x5BA3 recupera HL
C 0x5BA4 y BC
C 0x5BA6 (0xE833) = 0: pantalla en marcha
C 0x5BAB monta en 0xE7B0 los siete grupos de atributos en el orden de este cuadro (grupo_en_orden) y deja en HL el final
C 0x5BB0 DE = ultimo tamano de la lista de grupos (0xE729-0xE72F)
C 0x5BB3 DE' = destino en 0xE730
C 0x5BB8 A = tamano del grupo
C 0x5BB9 tamano anterior
C 0x5BBA guarda la lista
C 0x5BBB DE = tamano
C 0x5BBE HL -= tamano: principio del grupo
C 0x5BC1 recupera la lista
C 0x5BC2 guarda el tamano
C 0x5BC3 y el origen
C 0x5BC5 BC' = tamano
C 0x5BC8 HL' = origen
C 0x5BC9 guarda el tamano
C 0x5BCA y el destino
C 0x5BCB copia el grupo
C 0x5BCD recupera el destino
C 0x5BCE y el tamano
C 0x5BCF HL' = destino
C 0x5BD0 mas el tamano
C 0x5BD1 DE' = destino siguiente
C 0x5BD3 recupera el tamano
C 0x5BD4 guarda la lista
C 0x5BD5 DE = tamano
C 0x5BD9 HL -= tamano: el principio del grupo anterior (0xE7B0 se recorre de atras adelante: 0xE730 queda con los grupos al reves)
C 0x5BDB recupera la lista
C 0x5BDC A = tamano del grupo anterior
C 0x5BDD lista hacia atras
C 0x5BDE los siete grupos
C 0x5BE6 la tabla de atributos de 0x1B00: los grupos en el orden del cuadro
C 0x5BE9 desde 0xE7B0
C 0x5BEC 0x80 bytes: los 32 sprites
C 0x5BF2 la de 0x1F00: los mismos al reves; el registro 5 (0x5B77) dice cual se ve
C 0x5BF5 desde 0xE730
C 0x5BF8 0x80 bytes, y vuelve


# ----------------------------------------------------------------------
# Segunda pasada: los cuatro descompresores (0x52CF-0x53A4)
# ----------------------------------------------------------------------
C 0x52CF guarda el destino
C 0x52D0 en DE': la base del diccionario (lo ya escrito)
C 0x52D1 DE' = destino inicial
C 0x52D2 registros normales
C 0x52D4 C = mascara
C 0x52D6 B = valor de control; HL = primera ficha
C 0x52D7 guarda mascara y valor
C 0x52D8 la ficha
C 0x52D9 solo los bits de la mascara
C 0x52DA es de control?
C 0x52DE A = ~mascara
C 0x52DF A = la ficha sin los bits de control
C 0x52E0 siguiente byte
C 0x52E3 mascara par: tal cual
C 0x52E5 mascara impar: el bit 0 era de control, fuera
C 0x52E8 0 o 1: diccionario (0x52F9)
C 0x52EA 2 o mas: A + 1 repeticiones
C 0x52EC el byte a repetir
C 0x52ED al destino
C 0x52EE siguiente
C 0x52EF B veces
C 0x52F1 ficha siguiente
C 0x52F2 recupera mascara y valor
C 0x52F3 otra ficha
C 0x52F7 un literal: B = 1 y a copiarlo
C 0x52F9 0 o 1?
C 0x52FA 1: con los bits al reves (0x5302 con B = 1)
C 0x52FD indice 0xFF: fin
C 0x52FE otro indice: diccionario
C 0x5300 recupera mascara y valor
C 0x5301 HL = primera direccion despues del bloque
C 0x5302 guarda la ficha
C 0x5303 B = 0 (copia) o 1 (bits al reves)
C 0x5304 A = indice del diccionario
C 0x5305 registros alternativos
C 0x5307 HL' = indice
C 0x5309 por dos
C 0x530A por cuatro
C 0x530B por ocho
C 0x530C mas la base: la entrada de ocho bytes ya escrita
C 0x530D guardada
C 0x530E registros normales
C 0x530F HL = la entrada
C 0x5310 copia o al reves?
C 0x5311 cero: copia
C 0x5312 uno: al reves
C 0x5317 ocho bytes tal cual
C 0x5319 recupera el puntero de fichas
C 0x531A ficha siguiente
C 0x531E guarda el destino
C 0x531F un byte de la entrada
C 0x5322 un bit por la derecha
C 0x5323 entra por la izquierda de D
C 0x5325 los ocho bits
C 0x5327 A = el byte dado la vuelta
C 0x5328 recupera el destino
C 0x5329 al destino
C 0x532A siguiente
C 0x532B siguiente byte de la entrada
C 0x532C los ocho
C 0x532D otro byte
C 0x532F ficha siguiente
C 0x5331 C = mascara
C 0x5332 siguiente
C 0x5333 B = valor de control
C 0x5334 HL = primera ficha
C 0x5335 guarda mascara y valor
C 0x5336 la ficha
C 0x5337 solo los bits de la mascara
C 0x5338 es de control?
C 0x5339 no: literal
C 0x533B el byte siguiente
C 0x533D distinto de la ficha: repeticion
C 0x533F igual: recupera y acaba
C 0x5340 HL = primera direccion despues del bloque
C 0x5341 A = ~mascara
C 0x5342 complemento
C 0x5343 de vuelta a la ficha
C 0x5344 la ficha sin los bits de control
C 0x5345 al byte siguiente
C 0x5346 mascara impar?
C 0x5348 par: tal cual
C 0x534A impar: el bit 0 fuera
C 0x534D B = A + 3 repeticiones
C 0x534E el byte a repetir
C 0x534F al destino
C 0x5350 siguiente
C 0x5351 B veces
C 0x5353 ficha siguiente
C 0x5354 recupera mascara y valor
C 0x5355 otra ficha
C 0x5357 un literal
C 0x5359 a copiarlo
C 0x535B se salta el primer byte
C 0x535C C = la marca
C 0x535D primera ficha
C 0x535E la ficha
C 0x535F es la marca?
C 0x5360 no: literal
C 0x5362 el byte siguiente
C 0x5363 la marca otra vez: fin
C 0x5364 HL = la segunda marca
C 0x5365 A = el byte a repetir
C 0x5366 siguiente
C 0x5367 B = cuantas veces (0 = 256)
C 0x5368 al destino
C 0x5369 siguiente
C 0x536A B veces
C 0x536C ficha siguiente
C 0x536D otra ficha
C 0x536F un literal
C 0x5371 a copiarlo
C 0x5373 el primer byte de la ficha
C 0x5374 0x10 o mas: una sola pareja
C 0x5376 a copiarla
C 0x5379 B = alto de la cuenta
C 0x537A C = bajo
C 0x537B HL = la pareja
C 0x537C alto a cero?
C 0x537D no: cuenta de verdad
C 0x5380 cuenta cero: fin
C 0x5381 cuenta + 1
C 0x5382 A = primer byte de la pareja
C 0x5383 siguiente
C 0x5384 guarda el puntero
C 0x5385 L = segundo byte
C 0x5386 H = primero
C 0x5387 el primero
C 0x5388 al destino
C 0x5389 siguiente
C 0x538A el segundo
C 0x538B al destino
C 0x538C siguiente
C 0x538D una pareja menos
C 0x538E quedan?
C 0x5390 otra
C 0x5392 recupera el puntero
C 0x5393 ficha siguiente
C 0x5394 otra ficha
C 0x5399 una pareja: a copiarla
C 0x539B el primer registro de jugador
C 0x539F los seis
C 0x53A1 C = indice

# ----------------------------------------------------------------------
# Segunda pasada: la ventana sobre la pista y las poses (0x5F33-0x606D)
# ----------------------------------------------------------------------
C 0x5F33 C = cuantas columnas
C 0x5F37 fuera de la pista: nada
C 0x5F3B columna nueva
C 0x5F3C (0xE830) al dia
C 0x5F3F entre 0 y 24
C 0x5F42 DE = la columna, con signo
C 0x5F48 HL = la columna en la fila 0 del mapa
C 0x5F4B fila 0 de la tabla de nombres
C 0x5F4E guarda la cuenta de filas
C 0x5F52 guarda el destino
C 0x5F53 y el origen
C 0x5F54 32 bytes a la VRAM
C 0x5F57 recupera el origen
C 0x5F5B mas 56: la fila siguiente del mapa
C 0x5F5C recupera el destino
C 0x5F5D guarda el origen
C 0x5F5E 32 mas
C 0x5F61 la fila siguiente de la tabla de nombres
C 0x5F62 DE = destino
C 0x5F63 HL = origen
C 0x5F64 recupera la cuenta
C 0x5F65 las 24 filas
C 0x5F68 la columna
C 0x5F6B negativa?
C 0x5F6C no: mira el tope
C 0x5F6F si: cero
C 0x5F71 25 o mas?
C 0x5F73 no: vale
C 0x5F74 si: 25
C 0x5F77 la columna
C 0x5F7A mas lo que se quiere mover
C 0x5F7B negativa: no se puede
C 0x5F7E 25 o mas: no se puede
C 0x5F82 sin acarreo: se puede
C 0x5F84 acarreo: no
C 0x5F86 D = 0
C 0x5F88 E = A
C 0x5F89 negativo?
C 0x5F8A no: listo
C 0x5F8B si: D = 0xFF
C 0x5F8D el mapa de la pista comprimido
C 0x5F90 al bufer
C 0x5F93 descomprime y vuelve
C 0x5F99 cero: nada que hacer
C 0x5F9B (0xE71B) a cero
C 0x5F9F guarda todos los registros
C 0x5FAF el movimiento de los seis jugadores
C 0x5FB2 y el del balon
C 0x5FB5 recupera todos los registros
C 0x5FC6 bit 7: la pose cambio
C 0x5FC8 no: nada
C 0x5FC9 guarda A
C 0x5FCA quita la marca
C 0x5FCE recupera A
C 0x5FD1 guarda BC
C 0x5FD2 DE
C 0x5FD3 y HL
C 0x5FD7 campo +0x0F
C 0x5FDA HL = registro + 0x0F
C 0x5FDD menos dos
C 0x5FE0 HL = registro + 0x0D: la pose
C 0x5FE2 guarda el jugador
C 0x5FE3 y la pose
C 0x5FE4 HL = pose
C 0x5FE6 por dos
C 0x5FE7 por cuatro
C 0x5FEB HL = los cuatro patrones de la pose
C 0x5FEC guardados
