# ----------------------------------------------------------------------
# Segunda pasada sobre la cinta y el sonido (0x8C2F-0x8ED4)
# ----------------------------------------------------------------------
L 0x8C2F graba_equipo_sp  Entrada de SAVE DATA: guarda la pila en 0xEFDF (los errores de cinta vuelven aqui) y sigue en 0x8C33
C 0x8C2F la pila, para abortar desde 0x8D1A
C 0x8C33 guarda el inicio del bloque
C 0x8C3A TAPOON con A = 0: cabecera corta, la de los datos
C 0x8C3D HL = inicio
C 0x8C3E lo guarda otra vez
C 0x8C45 guarda el inicio
C 0x8C46 graba el fin
C 0x8C4C graba la direccion de ejecucion
C 0x8C4F DE = fin
C 0x8C50 HL = inicio
C 0x8C52 a la cinta
C 0x8C56 HL >= DE: era el ultimo
C 0x8C58 siguiente byte
C 0x8C59 otro mas
C 0x8C5E sin acarreo: bien
C 0x8C60 primero el byte bajo
C 0x8C64 luego el alto
C 0x8C68 byte bajo
C 0x8C6B a L
C 0x8C6C byte alto
C 0x8C6F a H
C 0x8C78 un byte de la cinta
C 0x8C7D HL = DE: era el ultimo
C 0x8C7F siguiente byte
C 0x8C80 otro mas
C 0x8C85 sin acarreo: bien
C 0x8C87 la pila, para abortar desde 0x8D1A
C 0x8C8B cabecera, inicio y fin (DE)
C 0x8C8E un byte de la cinta
C 0x8C92 distinto: acarreo
C 0x8C94 HL contra DE
C 0x8C95 era el ultimo
C 0x8C97 siguiente byte
C 0x8C98 otro mas
C 0x8C9D sin acarreo: bien
C 0x8C9F acarreo: no coincide
C 0x8CA1 guarda el destino
C 0x8CA4 diez 0xD0 y el nombre
C 0x8CA7 el motor otra vez: el bloque de datos
C 0x8CAD DE = inicio
C 0x8CB1 sin acarreo para la resta
C 0x8CB4 DE = destino
C 0x8CB6 guarda el fin relativo
C 0x8CBA DE = ejecucion (se tira)
C 0x8CBB DE = fin relativo
C 0x8CBD TAPION: busca una cabecera
C 0x8CC2 un byte
C 0x8CC6 no es la marca: otra cabecera
C 0x8CC8 diez seguidas
C 0x8CCD seis bytes de nombre
C 0x8CCF un byte
C 0x8CD2 a FILNAM
C 0x8CD3 siguiente
C 0x8CD4 los seis
C 0x8CD8 el ultimo, el penultimo, el antepenultimo
C 0x8CD9 un byte del nombre
C 0x8CDA es 0x7F?
C 0x8CDC no: no es un equipo, otra cabecera
C 0x8CDE los tres
C 0x8CE3 TAPOON
C 0x8CE6 diez marcas
C 0x8CEB las diez
C 0x8CED seis bytes de nombre
C 0x8CF2 un byte del nombre
C 0x8CF3 siguiente
C 0x8CF4 a la cinta
C 0x8CF7 los seis
C 0x8CFC guarda los registros
C 0x8D02 bien: a recuperarlos (0x8D2B)
C 0x8D04 mal: abortar
C 0x8D06 guarda los registros
C 0x8D0D bien: a recuperarlos
C 0x8D0F mal: abortar
C 0x8D11 guarda los registros
C 0x8D18 bien: a recuperarlos
C 0x8D21 acarreo: fallo
C 0x8D23 guarda los registros
C 0x8D2A los recupera
C 0x8D2F A = 0
C 0x8D33 A = 0xFF
C 0x8D37 prioridad ninguna
C 0x8D3E suena algo?
C 0x8D3F si: sigue esperando
C 0x8D42 guarda todos los registros
C 0x8D46 la de verdad
C 0x8D49 y los recupera
C 0x8D4E pieza negativa?
C 0x8D4F si: nada
C 0x8D50 E = pieza
C 0x8D51 BC = pieza
C 0x8D57 HL = su prioridad
C 0x8D5C menor que la que suena: no
C 0x8D5D A = prioridad de la nueva
C 0x8D5E ya es la que suena
C 0x8D63 menos de 30: entra siempre (0x8D6C)
C 0x8D65 30 o mas: mira si es la misma
C 0x8D67 la pieza que suena
C 0x8D6A es la misma?
C 0x8D6B si: no se reinicia
C 0x8D6C A = pieza
C 0x8D70 dos bytes por puntero
C 0x8D71 BC = desplazamiento
C 0x8D75 HL = su puntero
C 0x8D76 E = byte bajo
C 0x8D78 D = byte alto
C 0x8D79 sin interrupciones mientras se cambia
