L 0x76AE zona_tiro  Zona del jugador (0xED95) respecto a su canasta: 0 dentro de la zona, 1 media distancia, 2 triple; vigila los 3 segundos
C 0x76B3 jugador
C 0x76BA Y e X del jugador
C 0x76C0 referencia del equipo 0-2 (Y 0x3A, X 0x50)
C 0x76C7 la del equipo 3-5 (X 0xB0)
C 0x76CA distancia a la canasta
C 0x76CE 40 o mas: triple
C 0x76D3 fuera del ancho de la zona
C 0x76E0 fuera del largo de la zona
C 0x76E4 zona 0: dentro de la zona
C 0x76E8 sigue en la misma zona
C 0x76EA vencio la cuenta de 3 segundos?
C 0x76F0 rotulo 1: 3 SECOND
C 0x76F5 infractor
C 0x7701 210 cuadros de cuenta
C 0x7707 cuenta de 3 segundos en marcha
C 0x770B bit 7: repintar el rotulo AREA
C 0x770D zona nueva
C 0x7716 zona 1: media distancia
C 0x771D fuera de la zona: cuenta desactivada
C 0x7724 zona 2: triple
L 0x7728 misma_zona  Z si la zona A es la de (0xED96)
L 0x772E anota_tiro  Al tirar desactiva las cuentas y guarda el valor de la canasta (1 tiro libre, 2 o 3) y a quien sumarla
C 0x7738 bits del tiro (bit 6 tiro libre)
C 0x773E sin tiro
C 0x7742 tirador
C 0x7749 bit 7: equipo derecho
C 0x774E +0x1F del tirador
C 0x7759 campo 8 del roster: SUPOSICION tiros intentados
C 0x7760 tiro libre: 1 punto
C 0x7767 zona del tiro
C 0x7774 dentro de la zona tambien vale 2
C 0x7776 valor de la canasta
C 0x777B campo 4 del roster: SUPOSICION puntos del jugador
C 0x7780 donde se sumaran
C 0x7786 tiro atendido
L 0x7789 suma_canasta  Suma el valor de la canasta (0xED9A) al contador apuntado por (0xED9B), con tope 0xFF
L 0x7796 campo_1f  HL = +0x1F del jugador A
L 0x77A2 marcador_ram  Descomprime el marcador de 21 x 4 (0x77AB) a 0xEF77
C 0x6331 dentro de la zona: tiros libres

L 0x77DD logotipo  Descomprime el logotipo (0xB33E patrones, 0xB491 colores) a los patrones 0xB0-0xFF de los tres tercios
C 0x77E9 patrones 0xB0-0xFF del primer tercio
C 0x77F5 sus colores
C 0x77FE colores desde 0x2580
L 0x7807 tres_tercios  Copia BC bytes de HL a la VRAM DE y a los dos tercios siguientes (0x800 mas alla)
C 0x7807 tres tercios
L 0x781D colores_area  Colores de la pista segun COLOR OF COURT (tabla 0x785A) en los tres tercios y 0xAEC0 encima en 0x2100
C 0x7820 COLOR OF COURT
C 0x7828 tabla de bloques de color por AREA
C 0x7833 parejas repetidas
C 0x7839 tabla de colores 0x2000
C 0x7842 colores comunes a las tres AREAS
C 0x784E desde 0x2100
L 0x7866 rotulo_falta_marcador  Para el reloj y escribe en el marcador el rotulo, el jugador y sus faltas; con 5 faltas personales lo expulsa
C 0x7869 reloj parado
C 0x786E cuentas desactivadas
C 0x7873 tipo de falta (bits 3-6 de 0xEFCD)
C 0x787C cabecera de violacion
C 0x7883 cabecera de falta personal
C 0x7889 fila 1 del marcador
C 0x7891 rotulo del tipo
C 0x7896 nombre del jugador
C 0x78A2 numero del jugador
C 0x78AF campo 0x18 del roster: faltas personales
C 0x78C2 una falta mas
C 0x78C4 campo 5: faltas del partido
C 0x78CD faltas de equipo en el marcador
C 0x78DD una marca por falta
C 0x78EC SUPOSICION: quinta falta, jugador expulsado
C 0x78FE fuera de la mascara de jugadores en pista
C 0x7908 cuatro segundos de rotulo
C 0x7918 violacion: sigue el juego tras el rotulo
C 0x7920 expulsado: cambio obligado
C 0x7931 espera el rotulo
C 0x793B ventana otra vez al centro
L 0x7941 pinta_faltas_equipo  Faltas de equipo (0xEA2E y 0xEA5E) en 0x1847 y 0x1858
L 0x7950 dos_cifras_l  Numero L de dos cifras en la VRAM DE
L 0x7956 pinta_rotulo  Rotulo de falta de indice A (13 caracteres de 0x796F) en 0x184A

L 0x6EAF distancias_al_balon  SUPOSICION: lista en HL' el numero y la distancia al balon de los jugadores que no son los controlados
C 0x6EAF controlados de los dos equipos
C 0x6EBC numero del jugador
C 0x6EC1 balon
C 0x6ECE su distancia
L 0x6EDD destino_ix  Destino (D, E) del jugador IX
L 0x6EE4 destino_iy  Destino (D, E) del jugador IY
L 0x6EEB inicia_formacion  Arranca la formacion A (0-5) del equipo con el balon: pasos de cada atacante desde la tabla del equipo en 0xEA89
C 0x6EF2 solo las formaciones 0 a 5
C 0x6EF6 4 = alguno sin zona
C 0x6F01 formacion en +0x22 de los tres
C 0x6F06 bloque de la tabla del equipo
C 0x6F09 punteros de pasos de cada jugador
C 0x6F10 formacion en curso
C 0x6F14 letra que muestra FORMATION=
L 0x6F18 pon_formacion  +0x22 de los tres atacantes = A
C 0x6F19 equipo izquierdo
C 0x6F22 equipo derecho
L 0x6F30 pon_formacion_huerfano  Huerfano: pondria C con el bit 7 en +0x22 (el puntero del equipo derecho esta mal: 0x0022)
L 0x6F48 bloque_formacion  HL = guion de 24 bytes: 144 x formacion + 24 x (2 x carril del controlado + bit al azar)
C 0x6F4E zona del controlado
C 0x6F53 al azar una de dos variantes
C 0x6F59 24 bytes por variante
L 0x6F64 tabla_equipo  HL = 0xEA89 + A * 0x90 (144 bytes por formacion: 6 variantes x 3 jugadores x 8)
L 0x6F76 uno_o_dos_huerfano  Huerfano: 1 o 2 al azar
L 0x6F7D paso_formacion  HL = puntero al siguiente paso de la formacion del jugador A
L 0x6F85 punteros_formacion  Puntero de cada uno de los tres atacantes: bloque mas 8 por su zona
C 0x6F8D zona del jugador
L 0x6FAC avanza_paso  Guarda DE como puntero de pasos del jugador A
L 0x6FB6 puntero_paso  HL = 0xE84A + (A mod 3) * 2
L 0x6FC9 vigila_formacion  Cancela la formacion en curso si se cumple alguna condicion de corte
C 0x6FCC 0x3F: no hay formacion
C 0x6FE4 destinos de los tres atacantes
C 0x6FED equipo derecho
C 0x6FF7 sin destino
C 0x6FFD sin formacion

C 0x6FD0 el poseedor ya esta cerca de la canasta
C 0x6FD5 dos o mas atacantes ya sin pasos
C 0x6FDA tiro en vuelo
C 0x7003 sin formacion en curso
C 0x7006 repinta FORMATION=
L 0x700C hay_formacion  NZ si hay formacion en curso
L 0x7012 tiro_en_vuelo  Flags de 0xE6CF: negativo con el balon en vuelo
L 0x7017 acabados  Acarreo si dos o mas de los tres atacantes ya no tienen pasos (+0x22 = 0x3F)
C 0x7020 equipo derecho
C 0x702C sin pasos
L 0x7037 en_zona_poseedor  NZ si el poseedor esta en el rectangulo de su canasta de ataque (Y de 0x29 a 0x49 o de 0x28 a 0x48 segun el lado); Z si no o si el balon esta suelto
C 0x7040 registro del poseedor
C 0x7050 bit 4: lado de la canasta
C 0x7054 X de 0x41 a 0x5F
C 0x705C X de 0xA0 a 0xBE


# ----------------------------------------------------------------------
# Los mandos (0xB968-0xBAED): quien controla a cada equipo
# ----------------------------------------------------------------------
B 0xB968 ===== Lectura del mando del equipo A (0 izquierda, otro derecha) =====
L 0xB968 lee_mando_lado  Devuelve en A los botones (bit 7 disparo, bit 6 pase), en C la direccion 0-7 (0xFF quieto) y en DE su (dx, dy); segun (0xF012) cada lado es mando 1, mando 2 o la maquina
C 0xB96A (0xF012): modo de mandos 0-3, montado en 0x4089 con el bit 1 de 0xEFD6 y 0xEFD7 (equipo humano o maquina)
C 0xB96E modo * 3: cada entrada de la tabla es un jp de tres bytes
C 0xB973 A = 0 equipo de la izquierda, otro el de la derecha
C 0xB977 tabla de la derecha
C 0xB97C tabla de la izquierda
C 0xB980 la vuelta comun 0xB99D, apilada: el jp elegido acaba con ret
C 0xB984 salta al lector del lado y modo
L 0xB985 mandos_izquierda  Cuatro jp, uno por modo (0xF012): mando 2, mando 1, maquina, maquina
L 0xB991 mandos_derecha  Cuatro jp, uno por modo (0xF012): mando 1, maquina, mando 1, maquina
L 0xB99D mando_a_direccion  Vuelta comun: convierte la direccion GTSTCK (1-8) en indice 0-7 y (dx, dy) de 0xBA7B; la maquina (bit 0 de A) se salta la conversion
C 0xB99D bit 0 de A: lo devuelve la maquina (0x01 o 0x81), no un mando
C 0xB9A1 C = direccion GTSTCK 0-8
C 0xB9A5 nueve pares (dx, dy), el 0 es quieto
C 0xB9AC direccion 1-8 -> 0-7; quieto -> 0xFF
C 0xB9AE (0xF007): jugador cuyo mando se ignora (0xFF = ninguno; 0x50F1 lo pone a 0xFF al empezar)
C 0xB9B5 (0xE721): jugador que se esta leyendo
C 0xB9BB si es el ignorado: quieto y sin movimiento
L 0xB9C3 mando_1  Mando 1: joystick 1 y, si no da nada, los cursores con '[' (fila 1, bit 6) como disparo y RETURN (fila 7, bit 7) como pase
C 0xB9C7 algun boton o alguna direccion del joystick: vale
C 0xB9CC GTSTCK 0: los cursores del teclado
C 0xB9D2 fila 1 del teclado: 8 9 - ^ \ @ [ ;
C 0xB9DB a 1 las pulsadas
C 0xB9DD '[' pulsada: disparo
C 0xB9E3 fila 7: F4 F5 ESC TAB STOP BS SELECT RETURN
C 0xB9EC RETURN pulsada: pase
L 0xB9F4 joystick_1  Joystick 1: GTSTCK 1 en C, GTTRIG 1 y 3 (los dos botones) en los bits 7 y 6 de A
L 0xBA16 mando_2  Mando 2: joystick 2 y, si no da nada, cuatro teclas de las filas 3 y 5 convertidas con la tabla 0xBA8D, con TAB (fila 7, bit 3) como disparo y CTRL (fila 6, bit 1) como pase
C 0xBA1F fila 3 del teclado: B C D E F G H I
C 0xBA24 se quedan C, D y E (bits 1-3)
C 0xBA27 fila 5 del teclado: R S T U V W X Y
C 0xBA2E se queda R (bit 0)
C 0xBA31 a 1 las pulsadas: cuatro bits, 16 combinaciones
C 0xBA36 combinacion -> direccion GTSTCK 0-8
C 0xBA3D fila 7: TAB es el bit 3
C 0xBA44 TAB pulsada: disparo
C 0xBA4A fila 6: SHIFT CTRL GRAPH CAPS CODE F1 F2 F3
C 0xBA51 CTRL pulsada: pase
L 0xBA59 joystick_2  Joystick 2: GTSTCK 2 en C, GTTRIG 2 y 4 en los bits 7 y 6 de A
L 0xBA9D maquina_izquierda  El equipo de la izquierda lo lleva la maquina: decide con 0xBB14 o 0xBD61 segun que lado ataque (bit 0 de 0xE83C)
C 0xBA9D (0xF010): flag del lado izquierdo
C 0xBAA4 (0xE83C) bit 0: los lados estan cambiados
C 0xBAB0 el mismo codigo que el otro lado pero al reves
L 0xBAB5 maquina_derecha  El equipo de la derecha lo lleva la maquina
C 0xBAB5 (0xF011): flag del lado derecho
C 0xBACB decide el movimiento del jugador IX
C 0xBACE HL = su registro
C 0xBAD3 (IX+0x0C) a cero: devuelve 1 (sin boton)
L 0xBADC flag_a_codigo  A = 0x81 si (HL) no es cero, 0x01 si lo es: el bit 0 marca "maquina" para 0xB99D y el 7 el disparo
L 0xBAE4 boton_de_la_maquina  0x81 (disparo) si (IX+0x0B) es negativo, 0x01 si no


# ----------------------------------------------------------------------
# La maquina decide (0xBAEE-0xBD2E): a donde va el jugador que ataca
# ----------------------------------------------------------------------
L 0xBAEE huerfano_es_el_controlado  Huerfano: devuelve 0 si el jugador controlado es el que se esta leyendo (0xE721), y si no el bit 6 del campo +0x0F de su registro por el +0x0F*4
C 0xBAF1 (0xE721): jugador que se esta leyendo
C 0xBAF9 HL = registro del jugador A
C 0xBAFE campo +0x0F: patrones de la pose
L 0xBB0C sin_movimiento  A = 1 (sin boton), DE = 0 y C = 0x3F: la maquina no mueve a este jugador
L 0xBB14 decide_atacante  La maquina con el balon: segun el estado de 0xF009 elige objetivo (0), corre a el (1), encara la canasta (2), tira (3) o espera (4); deja el destino en (IX+0x20, IX+0x21)
C 0xBB1E Y (profundidad, +1) del jugador en curso (IY = su registro)
C 0xBB21 A = cuantos jugadores controla la maquina en este lado, B = el indice
C 0xBB24 (0xE623): X del balon a lo largo de la pista (+3 del registro 0xE620, con signo desde el centro), bit 7 = en la mitad izquierda
C 0xBB2C menos de tres controlados: destino X = 0xE2 (-30, hacia la canasta izquierda)
C 0xBB38 o X = 0x1E (+30, hacia la derecha)
C 0xBB3A destino: (IX+0x20) = Y (profundidad), (IX+0x21) = X
C 0xBB41 (0xF009): estado del ataque de la maquina, 0-4
C 0xBB59 hay sitio para tirar? (acarreo: si)
C 0xBB60 angulo (B) y distancia (A) del jugador HL a la canasta de 0xE6C3
C 0xBB68 lo mismo para el jugador IX
C 0xBB6D diferencia de distancias
C 0xBB70 menos de 11: se acerca con la tabla C2 del desfase
C 0xBB7D a menos de 10 se queda quieto
C 0xBB89 componente X: B * coseno (0xBBB5)
C 0xBB8E componente Y: B * seno
C 0xBB93 guarda la posicion del jugador en curso en 0xF00C/0xF00D
C 0xBB97 (0xF00E): X del destino
C 0xBB9B (0xF00F): Y del destino, 0x39 (la mitad de la pista) mas
C 0xBBA0 estado 1: correr al destino
C 0xBBA5 corrige el destino con la posicion de los companeros
L 0xBBB5 producto_con_signo  HL = A * L con el signo de H (multiplica16 y niega_hl)
C 0xBBBA el bit 7 de H es el signo
L 0xBBC9 seno_y_coseno  Devuelve en HL y DE las dos entradas de la tabla C2 del angulo E (0xC000-0xC2FF, montadas por 0x5A58)
L 0xBBD8 ataque_corriendo  Estado 1: al llegar al destino, si el controlado ya no tiene el balon pasa al estado 0; si lo tiene, estado 2 y 0x12 cuadros de espera (IX+0x26)
C 0xBBDC (IX+0x20/0x21) a cero: ya ha llegado
C 0xBBE3 (IY+0x0C): el jugador en curso lleva el balon
C 0xBBEE vuelve al estado 0
C 0xBBF2 C = 0x10: la orden de tirar para 0xBEBB
C 0xBBFA (IX+0x26): cuadros de espera antes de tirar
C 0xBBFE estado 2: encarar la canasta
L 0xBC04 ataque_encarando  Estado 2: pasada la espera, calcula el punto a cuatro de distancia de la canasta en la direccion del jugador y pasa al estado 3
C 0xBC13 0xE620: el registro del balon
C 0xBC16 A = distancia del balon a la canasta, B = angulo
C 0xBC19 cuatro menos: el punto de tiro
C 0xBC35 estado 3: ir al punto de tiro
L 0xBC3D ataque_al_punto_de_tiro  Estado 3: en cuanto llega (destino a cero) pasa al estado 4
L 0xBC44 ataque_estado_4  Estado 4: esperar el tiro
L 0xBC4A ataque_tira  Estado 4: si hay sitio tira (bit 0 de la pose); si no, al azar, roba o pasa el balon a un companero (0xED6F-0xED71)
C 0xBC4F sin sitio: quita el bit 0 de la pose
C 0xBC59 un byte al azar
C 0xBC5C una de cada cuatro veces sigue
C 0xBC63 azar contra la habilidad (IX+0x1D)
C 0xBC6B gana: roba el balon
C 0xBC71 puede pasar? (azar contra (IX+0x1E))
C 0xBC75 estado 0 de nuevo
C 0xBC7E companero 6 o 7 u 8 al azar: a quien pasa
C 0xBC84 (0xED6F): pase en marcha, (0xED71) y (0xED70) de quien a quien
L 0xBC90 puede_pasar  Acarreo si el juego esta parado para decidir y un byte al azar no llega a la habilidad (IX+0x1E)
L 0xBC9B hay_sitio_para_tirar  Acarreo si nadie lleva el balon, el balon esta a menos de 12 del centro (0xE623) y el jugador IX a menos de 8 de el
C 0xBC9F (0xE623): X del balon, con signo
C 0xBCA6 en valor absoluto
C 0xBCA8 a 12 o mas del centro: no
C 0xBCB2 campo +0x0C de los seis registros: alguien lleva el balon?
C 0xBCC0 (0xE621): Y (profundidad) del balon
C 0xBCCE distancia del jugador IX al balon
L 0xBCD4 se_puede_decidir  Acarreo (A = 6) si no hay falta ni tiempo muerto en marcha: 0xE6CF sin los bits 3 y 4, 0xED63 y 0xED79 a cero y el estado del juego (0xE6CF & 7) por debajo de 6
C 0xBCD4 (0xE6CF): estado del partido, bits 3 y 4 = la ventana se esta moviendo
C 0xBCDA (0xED63): falta en marcha
C 0xBCDF (0xED79): tiempo parado
L 0xBCEC quien_ataca  A = (0xE6D4) o (0xE6D6) segun el lado (0xE83C): el equipo que tiene el balon
L 0xBCFA guarda_posicion_en_f00c  Copia la Y (IY+1) y la X (IY+3) del jugador en curso a 0xF00D y 0xF00C
L 0xBD07 angulo_y_distancia_a_canasta  Para el jugador HL: A = distancia y B = angulo hasta la canasta de 0xE6C3
C 0xBD09 0xE6C3: la posicion de la canasta a la que se ataca
L 0xBD24 cuantos_controla  A = los jugadores que controla la maquina en este lado y B = el indice que devuelve 0x4EC5, con los flags de aquel


# ----------------------------------------------------------------------
# La maquina defiende y los ultimos cabos (0xBD2F-0xBFD3)
# ----------------------------------------------------------------------
L 0xBD2F corrige_destino_x  Suma a la X del destino (0xF00E) la X de la canasta de 0xE6C6
C 0xBD30 (0xE6C6): X de la canasta que se ataca
L 0xBD3D huerfano_niega_si_negativo  Huerfano: niega HL si H es negativo (nadie lo llama)
L 0xBD43 indice_controlado  A = el indice que devuelve 0xBD24 (el jugador controlado de este lado)
L 0xBD4A ha_llegado  Acarreo si el jugador en curso (IY) esta justo en la posicion guardada en 0xF00C/0xF00D; si no, estado 0
C 0xBD4A (0xF00D): Y guardada
C 0xBD52 (0xF00C): X guardada
C 0xBD5C (0xF009): estado del ataque a cero
L 0xBD61 decide_defensor  La maquina sin el balon: segun 0xF00A va a por el que lo lleva (0), lo marca (1) o se queda (2); con 0xF008 a uno no se mueve
C 0xBD61 (0xF008): a uno, la defensa no se mueve
C 0xBD68 E = 0x39, la Y de la mitad de la pista
C 0xBD6D (0xE623): X del balon, bit 7 = mitad izquierda
C 0xBD74 menos de tres controlados: destino abajo (0xBB30)
C 0xBD7B o arriba (0xBB38)
C 0xBD89 (0xF00A): estado de la defensa, 0-2
C 0xBD96 destino pendiente: nada que decidir
C 0xBD9D distancia del jugador IX a la canasta
C 0xBDA0 a menos de 20 de la canasta: se queda
C 0xBDAA (0xED8D): el reloj de los 30 segundos corre
C 0xBDB3 angulo y distancia del controlado (IY) a la canasta
C 0xBDBB y los del jugador IX
C 0xBDC0 el defensor mas lejos que el atacante: no vale
C 0xBDC9 diferencia de angulo de 64 o mas: no vale
C 0xBDCD seno y coseno del angulo del atacante
C 0xBDDC (0xF00E): X del punto entre los dos
C 0xBDEA distancia del atacante al punto
C 0xBDFF a menos de 8: ya esta encima (0xBE2B)
C 0xBE03 destino: Y 0x39 (la mitad), X la de la canasta menos 2 (o mas 2 en la mitad izquierda)
C 0xBE14 estado 1: ir al destino
L 0xBE1A distancia_a_canasta  A = distancia del jugador IX a la canasta (Y en 0xE6C4, X en 0xE6C6)
C 0xBE1A (0xE6C4): Y (profundidad) de la canasta
L 0xBE2B defensa_encima  Ya esta sobre el atacante: si 0x76AE lo permite, espera 20 + azar cuadros (IX+0x26) y pasa al estado 2
C 0xBE2E (0xED95): jugador al que se mira
C 0xBE3F 20 a 35 cuadros de espera
C 0xBE42 estado 2
L 0xBE48 defensa_estado_1  Estado 1: a menos de 20 de la canasta se queda; a menos de 8 del controlado, le roba o le tapa
C 0xBE5E distancia del jugador IX al controlado (IY)
C 0xBE65 destino pendiente: sigue
C 0xBE6C vuelve al estado 0
C 0xBE71 un paso en X hacia el centro
C 0xBE86 estado 0 y sin destino
C 0xBE89 la mitad de las veces tapa
C 0xBE90 puede pasar? (azar contra la habilidad)
C 0xBE9F el defensor mas cerca de la canasta que el atacante
C 0xBEAB companero 5: a quien pasa
L 0xBEB0 defensa_tapa  Si no hay desvio de tiro pide la orden 0x10 para el lado (0xF010/0xF011); si lo hay cambia la pose a la de brazos arriba (bits 2-4 de +0x0D mas 0x10)
C 0xBEBB menos de tres controlados: 0xF010, si no 0xF011
C 0xBEC3 ya hay una orden pendiente
C 0xBEC6 deja la orden C
C 0xBEC8 pose actual
C 0xBECC quita los bits 2-4
C 0xBED0 y los pone con el 4 a uno: la pose de tapar
L 0xBED9 defensa_estado_2  Estado 2: pasada la espera, elige al azar entre los dos companeros de 0xBF1E el que mira 0x76AE y le pasa el balon
C 0xBEE1 (IX+0x26): cuadros de espera
C 0xBEED B = indice del controlado
C 0xBEF1 0xBF1C + 2 * (indice + 1): los dos companeros del controlado (tabla 0xBF1E)
C 0xBEF9 (0xED95): el companero al que se mira
C 0xBF0A al azar, el otro
C 0xBF16 estado 0
C 0xBF1A C = 8: la orden de pasar
L 0xBF2A defensa_estado_0_destino  Estado 0: elige un punto a 10 grados del jugador respecto a la canasta, a un lado o al otro al azar, y lo prueba hasta que cae dentro de la pista
C 0xBF2A Y relativa a la mitad de la pista (0x3A)
C 0xBF34 X relativa a la canasta
C 0xBF38 20 mas, o 0xEC (-20) en la mitad izquierda
C 0xBF46 angulo del jugador respecto a la canasta
C 0xBF4D y la distancia
C 0xBF52 un bit al azar: a que lado
C 0xBF5A 10 grados menos
C 0xBF60 10 grados mas
C 0xBF66 seno y coseno
C 0xBF72 Y del punto, 0x39 mas
C 0xBF7E X del punto en la mitad izquierda (0xB0 mas)
C 0xBF82 o en la derecha (0x50 mas)
C 0xBF85 X fuera de 100-155: prueba el otro lado
C 0xBF96 Y fuera de 10-105: prueba el otro lado
C 0xBF9F destino (IX+0x20, IX+0x21)
C 0xBFA5 estado 1
C 0xBFAA (0xE850): formacion en curso, 0x3F = ninguna
C 0xBFB0 al azar 0-3, el 2 se convierte en 3
C 0xBFBA bit 7: formacion recien elegida
L 0xBFC0 descuenta_ordenes  Resta uno a las ordenes pendientes de los dos lados (0xF010, 0xF011) si no estan a cero


# ----------------------------------------------------------------------
# La cinta (0x8C2F-0x8D3A): el equipo como bloque BSAVE
# ----------------------------------------------------------------------
B 0x8C33 ===== La cinta: grabar, cargar y verificar el equipo =====
L 0x8C33 graba_equipo  SAVE DATA: escribe en cinta el bloque HL..(0xF87D) con la cabecera de los binarios (diez 0xD0 y el nombre de 0xF866), las direcciones de inicio, fin y (0xFCBF), y los bytes uno a uno con TAPOUT; acarreo si falla
C 0x8C34 0xD0: la marca de los bloques BSAVE
C 0x8C36 cabecera: motor, diez 0xD0 y los seis bytes del nombre
C 0x8C39 motor otra vez (TAPOON con A = 0: cabecera corta)
C 0x8C3F direccion de inicio (HL = el equipo, 0xE851 o 0xE93D)
C 0x8C42 (0xF87D): direccion de fin, SAVEND de la BIOS; 0x878F la deja a HL + 0xEB
C 0x8C49 (0xFCBF): la direccion de ejecucion que lleva todo BSAVE
C 0x8C51 un byte del equipo
C 0x8C55 DCOMPR: HL contra DE (el fin)
C 0x8C5B TAPOOF: motor parado
L 0x8C60 graba_palabra  Los dos bytes de HL, el bajo primero (TAPOUT)
L 0x8C68 lee_palabra  HL = dos bytes de la cinta, el bajo primero (TAPIN)
L 0x8C71 carga_equipo  LOAD DATA: busca la cabecera con el nombre del equipo, lee inicio y fin y vuelca los bytes en HL; acarreo si falla
C 0x8C71 guarda la pila: los errores de cinta vuelven aqui con 0x8D1D
C 0x8C75 cabecera, nombre e inicio/fin: devuelve en DE el fin
C 0x8C7B un byte al equipo
C 0x8C7C fin?
C 0x8C82 TAPIOF
L 0x8C87 verifica_equipo  VERIFY: igual que la carga pero comparando cada byte con el que hay; acarreo si alguno no coincide
C 0x8C91 distinto: error
L 0x8CA1 lee_cabecera_bsave  Busca la cabecera (0x8CBD), lee inicio, fin y ejecucion y deja en DE el fin trasladado a HL (HL + fin - inicio)
C 0x8CA2 la marca de los binarios
C 0x8CAA inicio en HL
C 0x8CAE fin en DE
C 0x8CB2 longitud = fin - inicio
C 0x8CB5 fin relativo al destino
C 0x8CB7 la direccion de ejecucion, que no se usa
L 0x8CBD busca_cabecera  TAPION y diez bytes seguidos iguales a C, luego los seis del nombre a 0xF866: tienen que acabar en tres 0x7F (0x87CD) o se sigue buscando
C 0x8CC0 diez marcas seguidas
C 0x8CC5 otra cosa: vuelve a empezar
C 0x8CCA FILNAM: los seis bytes del nombre
C 0x8CD6 los tres ultimos tienen que ser 0x7F
C 0x8CE0 ensena el nombre encontrado (FOUND:)
L 0x8CE3 graba_cabecera  Motor (TAPOON), diez veces A y los seis bytes del nombre de 0xF866
C 0x8CE8 diez marcas
C 0x8CEF FILNAM
L 0x8CFC lee_byte_cinta  TAPIN guardando los registros; si falla, aborta la operacion (0x8D1A)
L 0x8D06 graba_byte_cinta  TAPOUT guardando los registros; si falla, aborta
L 0x8D11 motor_lectura  TAPION guardando los registros; si falla, aborta
L 0x8D1A error_de_cinta  TAPIOF, recupera la pila guardada en 0xEFDF y vuelve con acarreo al que llamo a cargar o grabar
C 0x8D1D (0xEFDF): la pila de 0x8C71 / 0x8C87
L 0x8D23 motor_escritura  TAPOON guardando los registros
L 0x8D2F sonido_apagado  Pieza ninguna (0xFF) y contador a cero: lo llama INIT
C 0x8D30 (0xEFE6): cuadros que faltan para la ficha siguiente
C 0x8D34 (0xEFE1): pieza que suena, (0xEFE7): su prioridad; 0xFF = ninguna
L 0x8D3B huerfano_espera_sonido  Huerfano: espera a que se acabe el sonido en curso

# ----------------------------------------------------------------------
# El motor de sonido (0x8D42-0x8ED4): trece piezas de fichas de un byte
# ----------------------------------------------------------------------
B 0x8D42 ===== El motor de sonido: arrancar una pieza, el tick y el interprete =====
L 0x8D42 arranca_sonido  Pide la pieza A (0-12) guardando los registros: si no es de prioridad menor que la que suena, la pone en marcha
L 0x8D4E arranca_sonido_a  A negativo: nada. Compara la prioridad (0x8F71) con la de la pieza en curso; con 0x1E o mas no se repite la misma pieza
C 0x8D54 0x8F71: prioridad de cada pieza
C 0x8D58 (0xEFE7): prioridad de la que suena (0xFF si ninguna)
C 0x8D5B menor que la actual: no entra
C 0x8D61 prioridad 30 o mas: si ya suena esa misma pieza no se reinicia
C 0x8D6D (0xEFE1): la pieza en curso
C 0x8D72 0x8F57: los trece punteros
C 0x8D7A (0xEFE2): puntero a la ficha siguiente
C 0x8D7E (0xEFE4): la pila propia de las llamadas, que crece hacia abajo desde 0xF007
C 0x8D84 un cuadro y empieza
L 0x8D8B tick_sonido  Cada cuadro: si no suena nada marca 0xFF; si no, descuenta y al llegar a cero interpreta fichas hasta la siguiente espera
C 0x8D92 nada sonando: pieza y prioridad a 0xFF
C 0x8D9B todavia esperando
C 0x8D9D HL = ficha siguiente, IX = la pila
C 0x8DA4 interpreta hasta una espera: A = cuadros
L 0x8DB2 interpreta_ficha  Lee fichas desde HL hasta dar con una espera; devuelve en A los cuadros (0 acaba la pieza) y en HL la siguiente
C 0x8DB2 bits 7-6 a cero: no es nota
C 0x8DB7 canal = (ficha >> 6) - 1, por dos: el registro del periodo
C 0x8DBC indice de nota (0-63)
C 0x8DC4 0x8ED5: los 64 periodos de 16 bits
C 0x8DCA registro bajo del periodo
C 0x8DD0 registro alto
C 0x8DD7 bit 5 a cero: 0x00-0x1F, una espera
C 0x8DDD 0x1F: la espera vale lo que diga (0xEFE8)
C 0x8DE1 (0xEFE8): el tempo
C 0x8DE7 bit 4: 0x30-0x3F, ordenes
C 0x8DEB 0x20-0x2F: registro del PSG
C 0x8DED 0x20-0x25: el mezclador (registro 7) con un valor de 0x8F55
C 0x8DF2 0x8F55: los valores del registro 7
C 0x8DFF 0x26-0x2F: el registro del nibble bajo con el byte siguiente
C 0x8E07 0x3D: silencio
C 0x8E11 registros 0-5 a cero
C 0x8E1A 0x33: salto a la direccion que sigue
C 0x8E25 0x34: llamada; apila la vuelta en IX
C 0x8E3C 0x35: vuelta de la llamada
C 0x8E4D 0x36: abre un bucle; apila el puntero y la cuenta (0x1F = el tempo)
C 0x8E53 cuenta 0x1F: la de (0xEFE8)
C 0x8E6D 0x37: cierra el bucle; una vuelta menos, y si quedan salta al principio
C 0x8E71 (IX+0): la cuenta
C 0x8E7F cuenta agotada: saca los tres bytes y sigue
C 0x8E89 bit 3 a cero: 0x30, 0x32, 0x3C, deslizamiento de tono
C 0x8E8D 0x38-0x3B: volumen del canal (bits 1-0)
C 0x8E8F registros 8-10
C 0x8E92 el volumen actual
C 0x8E98 mas el byte siguiente, con signo
C 0x8E99 negativo: cero
C 0x8E9D tope de 16
C 0x8EAC registro del periodo: 0, 2 o 4
C 0x8EAF periodo actual, bajo
C 0x8EB5 y alto
C 0x8EBB el desplazamiento, con signo
C 0x8EC4 periodo nuevo
C 0x8EC8 bajo
C 0x8ECE alto

B 0x7084 ===== Plantillas: demo, jugadores en pista y jugadores al azar =====
L 0x7084 prepara_demo  Guarda los dos rosters, pone a cero las cuentas de equipo y crea dos equipos de nivel 4 para la demo de 60 segundos
C 0x7084 rosters de los dos equipos
C 0x7087 copia de seguridad en 0xED9D
C 0x708A 472 bytes
C 0x7090 cuentas del equipo izquierdo
C 0x7099 cuentas del equipo derecho
C 0x70A2 jugadores 0, 1 y 2 en la pista
C 0x70AC primera mitad
C 0x70AF equipo izquierdo, nivel 4
C 0x70B4 jugadores al azar
C 0x70B7 equipo derecho, nivel 4
C 0x70BF modos de verdad guardados
C 0x70C5 los dos equipos de la maquina
C 0x70CB mitad de 60 segundos
L 0x70D1 fin_demo  Devuelve los rosters y los modos guardados por 0x7084
C 0x70DC modos de verdad
L 0x70E3 crea_jugador  Jugador nuevo en HL: nombre de ocho ?, aspecto al azar y habilidades al azar sobre la base del equipo
C 0x70E4 jugador y equipo para 0x7E2E
C 0x70E7 29 bytes a cero
C 0x70F4 nombre ????????
C 0x70F9 aspecto al azar (0-31)
C 0x7104 campo 0x10 del roster
C 0x710D primera habilidad al azar
C 0x7113 segunda habilidad: base mas azar menos 16
C 0x7137 tope de la habilidad
C 0x7147 tercera habilidad
C 0x714E y su tope: 8 mas
L 0x7160 maximo_tres  Si A es menor que B lo guarda tres bytes atras; DE avanza tres
L 0x716E jugadores_en_pista  Copia a los seis registros las caracteristicas de los jugadores en pista, sus camisetas y su piel y pelo
C 0x716E SUPOSICION: bandera de mascara no vacia
C 0x717F equipo izquierdo
C 0x7182 mascara de jugadores en pista
C 0x7186 tres registros del equipo izquierdo
C 0x718A campo 0x0F del primer jugador del roster
C 0x7190 equipo derecho
C 0x71A3 color del sprite 3 (camiseta) del jugador 0
C 0x71A6 color del equipo izquierdo
C 0x71AC color del equipo derecho
C 0x71B2 +0x1F: jugador del roster
C 0x71B5 sombra de atributos
C 0x71B9 tres del equipo izquierdo
C 0x71C4 bit 7: equipo derecho
L 0x71CC piel_y_pelo  Colores de piel (sprites 0 y 1) y pelo (sprite 2) del jugador A segun su aspecto (tabla 0x80E4)
C 0x71D0 campo 8: aspecto
C 0x71D9 parejas (piel, pelo)
C 0x71E1 piel del sprite 0
C 0x71E4 y del sprite 1
C 0x71E7 pelo del sprite 2
C 0x71EE siguiente sombra de 16 bytes
L 0x71F4 camisetas  Nibble alto del color del equipo como color del sprite de camiseta de tres jugadores
C 0x71FA tres jugadores
L 0x7204 copia_caracteristicas  Para cada bit de C, copia al registro IX los campos del jugador del roster HL
C 0x7204 ocho del roster
L 0x7208 siguiente_del_roster  Bit del jugador: si esta en pista copia sus campos al siguiente registro
C 0x7208 bit del jugador
C 0x720A en el banquillo
C 0x720D +0x1F: numero en el roster
C 0x7210 campo 0x0F a +0x19
C 0x7215 campo 0x10 a +0x1A
C 0x721C SUPOSICION: campo 0x13 a +0x1C (salto)
C 0x7223 SUPOSICION: campo 0x16 a +0x1B (rapidez)
C 0x7229 campo 0x18 a +0x1D (SUPOSICION: robo)
C 0x722E cuenta del equipo 0x10 + jugador
C 0x7238 a +0x1E
C 0x723D siguiente registro
C 0x7244 siguiente jugador del roster
L 0x724D azar_a  Tres bytes al azar: 0, 0x14-0x23, 0x80-0xFF, 0xC0-0xFF
L 0x7258 azar_b  Dos bytes al azar: 0x80-0xFF y 0xC0-0xFF
L 0x726C azar_c  Tres bytes al azar: 0x0A-0x19, 0x08-0x0F, 0xC0-0xFF
L 0x7274 azar_d  Dos bytes al azar: 0x08-0x0F y 0xC0-0xFF
L 0x7288 azar_e  Dos bytes al azar: 0x0A-0x19 y 0xC0-0xFF
L 0x7290 azar_f  Un byte al azar 0xC0-0xFF
L 0x729B azar_g  Tres bytes al azar: 0x14-0x23, 0x04-0x07, 0x60-0x7F
L 0x72A3 azar_h  Dos bytes al azar: 0x04-0x07 y 0x60-0x7F
L 0x72B7 azar_i  Dos bytes al azar: 0x6E-0xAD y 0x32-0x51
L 0x72BF azar_j  Un byte al azar 0x32-0x51
L 0x72CA genera_equipo  Ocho jugadores de la maquina: aspecto al azar y habilidades segun el nivel de (0xEFCD)
C 0x72CE SUPOSICION: nombres de la maquina
C 0x72D1 campo 8 del primer jugador
C 0x72DA ocho jugadores
C 0x72DE aspecto al azar
C 0x72E8 campo 0x10: 30 por nivel mas 30
C 0x72EE campo 0x13: 30 por nivel mas 20
C 0x72F4 campo 0x16: 30 por nivel mas 25
C 0x72FC tope del 0x16 en 0x17
C 0x72FE campo 0x18: 10 por nivel mas 30
C 0x7304 campo 0x1B = 10
C 0x7308 siguiente jugador
L 0x730F segun_nivel  (HL) = D * nivel + E; HL avanza tres
C 0x730F nivel en los bits bajos
B 0x7E0F ===== Pantallas de plantilla y SET-UP =====
L 0x7E0F rellena_bloque  B filas de C bytes con D desde la VRAM HL
L 0x7E20 rellena_guarda  Rellena la VRAM conservando A y BC
L 0x7E28 cuadro_guarda  Cuadro de 0x7FC1 conservando DE
L 0x7E2E campo_jugador  HL = campo C del jugador (0xEFCD) & 7 del roster del equipo (bit 7)
C 0x7E31 jugadores del roster izquierdo
C 0x7E38 jugadores del roster derecho
C 0x7E45 29 bytes por jugador
L 0x7E4E campo_cabecera  HL = byte C de la cabecera del roster (nombre y nivel) del equipo de (0xEFCD)
L 0x7E61 campo_equipo  HL = cuenta C del equipo de (0xEFCD) en 0xEA29 o 0xEA59
L 0x7E74 modo_equipo  HL = modo del equipo de (0xEFCD): 0xEFD6 o 0xEFD7
L 0x7E7F pinta_nombres  Nombres de los ocho jugadores en la columna 6 desde la fila 10
C 0x7E8D fila 10, columna 6
C 0x7E94 8 caracteres
C 0x7E9E siguiente jugador del roster
L 0x7EB2 pinta_faltas  Columna FOULS: cinco casillas 0x6E con una marca 0x6F por falta personal
C 0x7EB5 8 filas de 5
C 0x7EBD faltas personales de cada jugador
L 0x7EE0 pinta_en_pista  Marca 0x73 en los jugadores en pista y 0x72 en los del banquillo
C 0x7EE0 mascara de jugadores en pista
C 0x7EEE bit del jugador
L 0x7EFB pinta_habilidad  Tres barras de habilidad del jugador (campos 0x10, 0x13, 0x16) si el bit 6 de 0xEFCD lo pide
C 0x7F00 fondo de la barra
C 0x7F07 3 filas de 8
L 0x7F28 barra  Barra del valor (DE)/4: bloques llenos 0xBF por cada 8 y un final 0xB7-0xBE
C 0x7F3A bloque lleno
C 0x7F42 bloque final segun el resto
L 0x7F51 pinta_fatiga  Barras de FATIGUE de los ocho jugadores (byte alto del cansancio)
C 0x7F5C cansancio de los ocho
L 0x7F70 pinta_estadisticas  Tres contadores de 16 bits del jugador (campo 9) en cuatro cifras
C 0x7F82 cuatro cifras
L 0x7F90 cabecera_equipo  Franja del equipo (0xB0 izquierdo, 0xB3 derecho), sus extremos y el nombre
L 0x7FC1 cuadro  Cuadro de D filas y E+1 de ancho: esquinas, lados y bordes
C 0x7FC2 esquina superior izquierda
C 0x7FC7 borde superior
C 0x7FCC esquina superior derecha
C 0x7FDC esquina inferior izquierda
C 0x7FE1 borde inferior
C 0x7FE6 esquina inferior derecha
C 0x7FF1 lado izquierdo
C 0x7FFB lado derecho
L 0x7FFD columna  B-1 veces el caracter C hacia abajo
L 0x800C linea  E caracteres A a la derecha de HL
L 0x8018 sprites_plantilla  Pose 0x90 del jugador 0 en la VRAM y dos grupos de cuatro sprites para mostrar a los jugadores
C 0x8023 pose 0x90: de frente
C 0x8025 sus patrones a 0x3800
C 0x8029 tabla de atributos visible
C 0x802E patrones 0, 4, 8, 12
C 0x803C y el segundo grupo igual
C 0x8048 Y 0xC0: ocultos de momento
C 0x8057 fin de la lista de sprites
L 0x805C viste_jugador  Colores del grupo de sprites del jugador de (0xEFCD) y su colocacion en DE
C 0x805F color del equipo
C 0x8069 camiseta en el sprite 3
C 0x8071 aspecto del jugador
C 0x8083 piel en los sprites 0 y 1
C 0x8095 pelo en el sprite 2
C 0x809D colocacion de la pose 0x90
C 0x80B9 Y menos dy
C 0x80C3 X menos dx
L 0x80D1 atributo_plantilla  HL = 0x1B00 (izquierdo) o 0x1B10 (derecho) mas C
L 0x8124 borra_rotulo  Dos filas de 12 espacios en 0x1831

B 0x812F ===== SET-UP, titulo y menus de equipo =====
L 0x812F pantalla_setup  Pantalla SET-UP: START, STARTERS, cambio de lados, de colores, LENGTH OF HALF y COLOR OF COURT; acarreo = ESC
C 0x8132 fondo de la pantalla (0xB22A)
C 0x8135 opcion 0
L 0x8138 setup_repinta  Nombres, marcas de LENGTH y de COLOR OF COURT
C 0x8138 nombres de los equipos
C 0x813B marca de LENGTH OF HALF
C 0x813E marca de COLOR OF COURT
L 0x8141 setup_menu  Selector de seis opciones con el cursor 0x6F en la columna 8
C 0x8141 cursor en 0x1A28
C 0x8144 seis opciones, cursor 0x6F
C 0x814B ESC: vuelve al menu
C 0x814F espacio: elige
C 0x8153 cursor derecha
C 0x8157 cursor izquierda
C 0x815C opcion 2: cambia los equipos de lado
C 0x8165 opcion 3: cambia los colores
C 0x816E opcion 4: LENGTH OF HALF
C 0x8177 opcion 5: COLOR OF COURT
C 0x8180 opcion 0: START
C 0x8184 primera mitad y reloj
C 0x8187 sin acarreo: a jugar
C 0x8189 opcion 1: STARTERS
L 0x8192 setup_esc  Acarreo: vuelta al menu del titulo
L 0x8194 fondo_setup  Descomprime el fondo del SET-UP (0xB22A) y lo copia a la tabla de nombres
L 0x81A9 nombres_setup  Nombres de los dos equipos en 0x18C7 y 0x18D6
L 0x81BB marca_length  Borra las cuatro marcas y pone 0xF9 en la de LENGTH OF HALF
C 0x81BB cuatro casillas de 4 en 4
C 0x81CE LENGTH OF HALF por 4
L 0x81D3 pon_marca  Marca 0xF9 en DE + desplazamiento
L 0x81DC marca_court  Borra las tres marcas y pone la de COLOR OF COURT
C 0x81DC tres casillas de 5 en 5
C 0x81EF COLOR OF COURT por 5
L 0x81F8 cambia_lados  Intercambia los modos y los rosters (0xEC bytes) de los dos equipos
C 0x81F8 modos de los dos equipos
C 0x8201 roster izquierdo
C 0x8204 roster derecho
C 0x8207 236 bytes
L 0x820A intercambia_bloque  Intercambia BC bytes entre HL y DE
L 0x8218 cambia_colores  Intercambia los colores de los equipos y repinta sus franjas
C 0x8218 color del izquierdo
C 0x821B color del derecho
L 0x8223 pinta_franjas  Franjas de color de los dos equipos (24 bytes de color en 0x2580 y 0x2598)
C 0x8229 color del izquierdo
C 0x8232 color del derecho
L 0x8238 cambia_length  LENGTH OF HALF mas o menos uno (0-3) segun la tecla
C 0x823D derecha: uno mas
C 0x8246 da la vuelta en 4
L 0x824C cambia_court  COLOR OF COURT mas o menos uno (0-2) y los colores de equipo de esa pista (0x785C)
C 0x825A paso de 2 a 0
C 0x8262 paso de 0 a 2
C 0x826F colores de equipo de la pista
C 0x8274 color del izquierdo
C 0x8279 color del derecho
L 0x827F pantalla_starters  STARTERS: cada equipo humano elige sus tres titulares
C 0x8282 franjas de los rotulos
C 0x8293 STARTERS
C 0x829D equipo izquierdo
C 0x82A0 modo 0: elige sus titulares
C 0x82AF equipo derecho
C 0x82C3 titulares a los registros
L 0x82C6 elige_titulares  Cursor sobre los ocho jugadores: espacio pone o quita, izquierda/derecha cambian de vista; ESC con tres titulares
C 0x82CC sin barras de habilidad
L 0x82D1 titulares_muestra  Viste el sprite del jugador del cursor
L 0x82D7 titulares_pinta  Marcas de titular
L 0x82DD titulares_menu  Selector de los ocho jugadores
C 0x82DD ocho opciones, cursor 0xF9
C 0x82E6 ESC
