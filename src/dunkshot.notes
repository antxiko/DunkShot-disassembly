C 0x8E44 H = vuelta alta
C 0x8E47 L = vuelta baja
C 0x8E4A sigue en la vuelta
C 0x8E4F no es 0x36
C 0x8E51 el byte de la cuenta
C 0x8E52 A = cuenta
C 0x8E55 no es 0x1F: tal cual
C 0x8E57 cuenta = el tempo
C 0x8E5A HL = primera ficha del bucle
C 0x8E5B puntero alto a la pila propia
C 0x8E5E puntero bajo
C 0x8E61 y la cuenta
C 0x8E64 la pila baja tres
C 0x8E6A sigue dentro del bucle
C 0x8E6F no es 0x37
C 0x8E74 cero: se acabo el bucle
C 0x8E76 L = puntero bajo
C 0x8E79 H = puntero alto
C 0x8E7C otra vuelta
C 0x8E81 la pila sube tres
C 0x8E85 ficha siguiente
C 0x8E86 sigue detras del bucle
C 0x8E8B a uno: deslizamiento (0x8EAC)
C 0x8E91 guarda el registro
C 0x8E95 volumen 0-15
C 0x8E97 el byte del cambio
C 0x8E9C negativo: cero
C 0x8E9F menos de 17: vale
C 0x8EA1 17 o mas: 16
C 0x8EA3 E = volumen nuevo
C 0x8EA4 A = registro
C 0x8EA8 ficha siguiente
C 0x8EA9 y otra ficha
