# ----------------------------------------------------------------------
# Segunda pasada sobre los mandos y la IA (0xB968-0xBFD3)
# ----------------------------------------------------------------------
C 0xB968 guarda HL
C 0xB969 y el lado (A)
C 0xB96D C = modo
C 0xB96F A = modo * 3
C 0xB970 HL = desplazamiento en la tabla
C 0xB974 que lado?
C 0xB975 cero: la izquierda
C 0xB97F HL = direccion del jp de este lado y modo
C 0xB983 vuelta en la pila
C 0xB985 modo 0: la izquierda con el mando 2
C 0xB988 modo 1: la izquierda con el mando 1
C 0xB98B modo 2: la izquierda la lleva la maquina
C 0xB98E modo 3: las dos la maquina
C 0xB991 modo 0: la derecha con el mando 1
C 0xB994 modo 1: la derecha la lleva la maquina
C 0xB997 modo 2: la derecha con el mando 1
C 0xB99A modo 3: las dos la maquina
C 0xB99F maquina: sin tabla de direcciones
C 0xB9A2 HL = direccion * 2
C 0xB9A8 HL = su par (dx, dy)
C 0xB9A9 D = dx
C 0xB9AB E = dy
C 0xB9AD guarda los botones
C 0xB9B1 0xFF: ningun jugador bloqueado
C 0xB9B8 es este el bloqueado?
C 0xB9BD DE = 0: no se mueve
C 0xB9C0 recupera los botones
C 0xB9C1 y HL
C 0xB9C3 primero el joystick 1
C 0xB9C6 B = botones
C 0xB9C9 botones o direccion: hay entrada
C 0xB9CA A = botones
C 0xB9CB con entrada del joystick, listo
C 0xB9D1 C = direccion de los cursores
C 0xB9D4 SNSMAT no respeta BC
C 0xB9D9 B = botones, de momento ninguno
C 0xB9DF '[' no pulsada
C 0xB9E1 bit 7: disparo
C 0xB9E5 SNSMAT no respeta BC
C 0xB9EE RETURN no pulsada
C 0xB9F0 bit 6: pase
C 0xB9F2 A = botones
C 0xB9F4 GTSTCK 1: el joystick del puerto 1
C 0xB9F9 C = direccion 0-8
C 0xB9FA B = botones
C 0xB9FC GTTRIG 1: boton A del puerto 1
C 0xB9FE GTTRIG no respeta BC
C 0xBA03 pulsado?
C 0xBA06 bit 7: disparo
C 0xBA08 GTTRIG 3: boton B del puerto 1
C 0xBA0F pulsado?
C 0xBA12 bit 6: pase
C 0xBA14 A = botones
C 0xBA16 primero el joystick 2
C 0xBA19 B = botones
C 0xBA1A solo los bits de boton
C 0xBA1C botones o direccion: hay entrada
C 0xBA1D A = botones
C 0xBA1E con entrada del joystick, listo
C 0xBA26 C = C, D, E en los bits 1-3
C 0xBA29 SNSMAT no respeta BC
C 0xBA30 mas R en el bit 0
C 0xBA33 DE = indice en la tabla
C 0xBA3A C = direccion 0-8
C 0xBA3B B = botones, de momento ninguno
C 0xBA3F SNSMAT no respeta BC
C 0xBA46 TAB no pulsada
C 0xBA48 bit 7: disparo
C 0xBA4C SNSMAT no respeta BC
C 0xBA53 CTRL no pulsada
C 0xBA55 bit 6: pase
C 0xBA57 A = botones
C 0xBA59 GTSTCK 2: el joystick del puerto 2
C 0xBA5E C = direccion 0-8
C 0xBA5F B = botones
C 0xBA61 GTTRIG 2: boton A del puerto 2
C 0xBA63 GTTRIG no respeta BC
C 0xBA68 pulsado?
C 0xBA6B bit 7: disparo
C 0xBA6D GTTRIG 4: boton B del puerto 2
C 0xBA74 pulsado?
C 0xBA77 bit 6: pase
C 0xBA79 A = botones
C 0xBAA0 A = 0x81 si hay orden pendiente, 0x01 si no
C 0xBAA3 guarda el codigo
C 0xBAA7 bit 0: lados cambiados
C 0xBAA9 cambiados: decide como el otro lado
C 0xBAAB la izquierda defiende: decide_defensor
C 0xBAB8 A = 0x81 si hay orden pendiente, 0x01 si no
C 0xBABB guarda el codigo
C 0xBABF bit 0: lados cambiados
C 0xBAC1 cambiados: decide como el otro lado
C 0xBAC3 la derecha ataca: decide_atacante
C 0xBAC8 la derecha defiende
C 0xBAD1 recupera el codigo
C 0xBAD2 con orden pendiente (0x81): devuelve el codigo tal cual
C 0xBAD6 lleva el balon?
C 0xBAD7 si: mira si tira
C 0xBAD9 no: sin boton
C 0xBADC la orden pendiente del lado
C 0xBADE 0x81: maquina con orden
C 0xBAE1 0x01: maquina sin orden
C 0xBAE7 (IX+0x0B) negativo: tirar
C 0xBAE8 0x81: disparo
C 0xBAEB 0x01: sin boton
C 0xBAF4 el controlado es el que se lee?
C 0xBAF7 si: cero
C 0xBAFC guarda el registro
